#!/bin/bash

# Цвета для красивого вывода
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Функция для красивого заголовка
print_header() {
    echo ""
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
    echo -e "${BOLD}  🔍 VPS Watchdog - Автоматический сбор данных для настройки${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
    echo ""
}

# Функция для проверки ошибок
check_error() {
    if [ $? -ne 0 ]; then
        echo -e "${RED}❌ Ошибка: $1${NC}"
        exit 1
    fi
}

# Функция для проверки команды
check_command() {
    if ! command -v $1 &> /dev/null; then
        echo -e "${RED}❌ Команда '$1' не найдена. Установи её сначала.${NC}"
        exit 1
    fi
}

print_header

# Проверка необходимых команд
check_command yc
check_command jq

# Проверка что yc настроен
echo -e "${BLUE}🔧 Проверяю yc CLI настроен...${NC}"
if ! yc config profile list &> /dev/null; then
    echo -e "${RED}❌ yc CLI не настроен. Запусти 'yc init' сначала${NC}"
    exit 1
fi
echo -e "${GREEN}✅ yc CLI настроен${NC}"

# Получение Folder ID
FOLDER_ID=$(yc config get folder-id 2>/dev/null)
if [ -z "$FOLDER_ID" ]; then
    echo -e "${RED}❌ Folder ID не найден${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Folder ID: ${FOLDER_ID}${NC}"
echo ""

# Получение списка VM
echo -e "${BLUE}🖥️  Получаю список виртуальных машин...${NC}"
VM_LIST=$(yc compute instance list --folder-id "$FOLDER_ID" --format json 2>&1)
if [ $? -ne 0 ]; then
    echo -e "${RED}❌ Ошибка получения списка VM:${NC}"
    echo "$VM_LIST"
    exit 1
fi

VM_COUNT=$(echo "$VM_LIST" | jq '. | length')
if [ "$VM_COUNT" -eq 0 ]; then
    echo -e "${RED}❌ Виртуальные машины не найдены${NC}"
    exit 1
fi

echo -e "${GREEN}✅ Найдено VM: ${VM_COUNT}${NC}"
echo ""
echo -e "${CYAN}┌────────────────────────────────────────────────────────────────┐${NC}"
echo -e "${CYAN}│${NC}${BOLD}                     ДОСТУПНЫЕ ВИРТУАЛЬНЫЕ МАШИНЫ                ${NC}${CYAN}│${NC}"
echo -e "${CYAN}└────────────────────────────────────────────────────────────────┘${NC}"
echo ""

# Вывод списка VM
i=1
declare -A VM_IDS
declare -A VM_IPS
declare -A VM_NAMES

while IFS= read -r vm; do
    vm_id=$(echo "$vm" | jq -r '.id')
    vm_name=$(echo "$vm" | jq -r '.name')
    vm_status=$(echo "$vm" | jq -r '.status')
    vm_zone=$(echo "$vm" | jq -r '.zone_id')
    vm_ip=$(echo "$vm" | jq -r '.network_interfaces[0].primary_v4_address.one_to_one_nat.address // "нет IP"')
    
    VM_IDS[$i]="$vm_id"
    VM_IPS[$i]="$vm_ip"
    VM_NAMES[$i]="$vm_name"
    
    echo -e "${BOLD}${i})${NC} ${YELLOW}${vm_name}${NC}"
    echo -e "   ID:     ${vm_id}"
    echo -e "   IP:     ${CYAN}${vm_ip}${NC}"
    echo -e "   Статус: ${GREEN}${vm_status}${NC}"
    echo -e "   Зона:   ${vm_zone}"
    echo ""
    
    ((i++))
done < <(echo "$VM_LIST" | jq -c '.[]')

# Выбор VM
echo -e "${BOLD}Выбери номер VM для мониторинга:${NC} "
read vm_choice

if [ -z "${VM_IDS[$vm_choice]}" ]; then
    echo -e "${RED}❌ Неверный выбор${NC}"
    exit 1
fi

INSTANCE_ID="${VM_IDS[$vm_choice]}"
VM_HOST="${VM_IPS[$vm_choice]}"
VM_NAME="${VM_NAMES[$vm_choice]}"

echo ""
echo -e "${GREEN}✅ Выбрана VM:${NC}"
echo -e "   ${BOLD}Instance ID:${NC} ${INSTANCE_ID}"
echo -e "   ${BOLD}VM Host:${NC}     ${VM_HOST}"
echo ""

# Проверка Service Accounts
echo -e "${BLUE}🔑 Проверяю Service Accounts...${NC}"
SA_LIST=$(yc iam service-account list --folder-id "$FOLDER_ID" --format json 2>&1)
if [ $? -ne 0 ]; then
    echo -e "${YELLOW}⚠️  Не удалось получить список SA, создам новый${NC}"
    SA_COUNT=0
else
    SA_COUNT=$(echo "$SA_LIST" | jq '. | length')
    echo -e "${GREEN}✅ Найдено Service Accounts: ${SA_COUNT}${NC}"
fi

# Выбор: использовать существующий или создать новый SA
SA_ID=""
SA_NAME=""

if [ "$SA_COUNT" -gt 0 ]; then
    echo ""
    echo "Хочешь использовать существующий SA или создать новый?"
    echo "  1) Использовать существующий"
    echo "  2) Создать новый"
    echo -n "Выбери: "
    read sa_choice
    
    if [ "$sa_choice" = "1" ]; then
        echo ""
        i=1
        declare -A SA_IDS
        declare -A SA_NAMES
        
        while IFS= read -r sa; do
            sa_id=$(echo "$sa" | jq -r '.id')
            sa_name=$(echo "$sa" | jq -r '.name')
            
            SA_IDS[$i]="$sa_id"
            SA_NAMES[$i]="$sa_name"
            
            echo "${i}) ${sa_name} (${sa_id})"
            ((i++))
        done < <(echo "$SA_LIST" | jq -c '.[]')
        
        echo -n "Выбери номер SA: "
        read sa_num
        
        SA_ID="${SA_IDS[$sa_num]}"
        SA_NAME="${SA_NAMES[$sa_num]}"
        
        if [ -z "$SA_ID" ]; then
            echo -e "${RED}❌ Неверный выбор${NC}"
            exit 1
        fi
        
        echo -e "${GREEN}✅ Использую существующий SA: ${SA_NAME}${NC}"
    else
        sa_choice="2"
    fi
fi

# Создание нового SA если нужно
if [ "$sa_choice" = "2" ] || [ "$SA_COUNT" -eq 0 ]; then
    echo ""
    echo -e "${BLUE}🔨 Создаю новый Service Account...${NC}"
    
    SA_NAME="watchdog-$(date +%s)"
    
    # ИСПРАВЛЕНИЕ: Добавляем --format json
    SA_CREATE_OUTPUT=$(yc iam service-account create \
        --name "$SA_NAME" \
        --folder-id "$FOLDER_ID" \
        --format json 2>&1)
    
    if [ $? -ne 0 ]; then
        echo -e "${RED}❌ Ошибка создания Service Account:${NC}"
        echo "$SA_CREATE_OUTPUT"
        exit 1
    fi
    
    SA_ID=$(echo "$SA_CREATE_OUTPUT" | jq -r '.id')
    
    if [ -z "$SA_ID" ] || [ "$SA_ID" = "null" ]; then
        echo -e "${RED}❌ Не удалось получить ID созданного Service Account${NC}"
        echo "Вывод команды: $SA_CREATE_OUTPUT"
        exit 1
    fi
    
    echo -e "${GREEN}✅ Service Account создан: ${SA_NAME}${NC}"
    echo -e "   ID: ${SA_ID}"
    
    # Выдача прав
    echo -e "${BLUE}🔐 Выдаю права compute.operator...${NC}"
    yc resource-manager folder add-access-binding "$FOLDER_ID" \
        --role compute.operator \
        --subject serviceAccount:"$SA_ID" \
        --format json > /dev/null 2>&1
    check_error "Не удалось выдать права"
    
    echo -e "${GREEN}✅ Права выданы${NC}"
fi

# Создание ключа
echo ""
echo -e "${BLUE}🔐 Создаю авторизованный ключ...${NC}"

KEY_FILE="/tmp/watchdog-key-$(date +%s).json"

yc iam key create \
    --service-account-id "$SA_ID" \
    --output "$KEY_FILE" \
    --format json > /dev/null 2>&1
check_error "Не удалось создать ключ"

echo -e "${GREEN}✅ Ключ создан: ${KEY_FILE}${NC}"

# Итоговая информация
echo ""
echo -e "${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo -e "${BOLD}${GREEN}          ✅ ВСЕ ДАННЫЕ СОБРАНЫ УСПЕШНО!${NC}"
echo -e "${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "${BOLD}📋 ДАННЫЕ ДЛЯ НАСТРОЙКИ:${NC}"
echo ""
echo -e "${CYAN}┌─────────────────────────────────────────────────────────────────┐${NC}"
echo -e "${CYAN}│${NC} ${BOLD}VM_HOST${NC} (внешний IP VM)                                         ${CYAN}│${NC}"
echo -e "${CYAN}│${NC} ${GREEN}${VM_HOST}${NC}                                                    ${CYAN}│${NC}"
echo -e "${CYAN}│${NC}                                                                 ${CYAN}│${NC}"
echo -e "${CYAN}│${NC} ${BOLD}INSTANCE_ID${NC} (ID виртуальной машины)                             ${CYAN}│${NC}"
echo -e "${CYAN}│${NC} ${GREEN}${INSTANCE_ID}${NC}                                             ${CYAN}│${NC}"
echo -e "${CYAN}│${NC}                                                                 ${CYAN}│${NC}"
echo -e "${CYAN}│${NC} ${BOLD}SA_KEY_FILE${NC} (путь к ключу Service Account)                     ${CYAN}│${NC}"
echo -e "${CYAN}│${NC} ${GREEN}${KEY_FILE}${NC}                               ${CYAN}│${NC}"
echo -e "${CYAN}│${NC}                                                                 ${CYAN}│${NC}"
echo -e "${CYAN}│${NC} ${BOLD}Service Account${NC}                                                 ${CYAN}│${NC}"
echo -e "${CYAN}│${NC} ${GREEN}${SA_NAME}${NC}                                             ${CYAN}│${NC}"
echo -e "${CYAN}└─────────────────────────────────────────────────────────────────┘${NC}"
echo ""

echo -e "${BOLD}📝 ЧТО ДАЛЬШЕ:${NC}"
echo ""
echo -e "${YELLOW}1️⃣${NC}  Скопируй ключ на сервер:"
echo -e "   ${CYAN}scp ${KEY_FILE} root@ВАШ_СЕРВЕР:/opt/vps-watchdog/config/sa-key.json${NC}"
echo ""
echo -e "${YELLOW}2️⃣${NC}  На сервере открой конфиг:"
echo -e "   ${CYAN}sudo nano /opt/vps-watchdog/config/watchdog.env${NC}"
echo ""
echo -e "${YELLOW}3️⃣${NC}  Впиши эти данные:"
echo -e "   ${CYAN}VM_HOST=${VM_HOST}${NC}"
echo -e "   ${CYAN}INSTANCE_ID=${INSTANCE_ID}${NC}"
echo ""
echo -e "${YELLOW}4️⃣${NC}  Перезапусти сервис:"
echo -e "   ${CYAN}sudo systemctl restart vps-watchdog${NC}"
echo ""
echo -e "${YELLOW}5️⃣${NC}  Проверь логи:"
echo -e "   ${CYAN}sudo docker logs -f vps-watchdog${NC}"
echo ""
echo -e "${GREEN}✅ Готово! Все данные сохранены в: ${KEY_FILE}${NC}"
echo ""
