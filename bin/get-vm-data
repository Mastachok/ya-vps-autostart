#!/usr/bin/env bash
set -euo pipefail

# ═══════════════════════════════════════════════════════════════════
# VPS Watchdog - Автоматический сборщик данных для настройки
# ═══════════════════════════════════════════════════════════════════

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo -e "${BOLD}${CYAN}  🔍 VPS Watchdog - Автоматический сбор данных для настройки${NC}"
echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo

# ═══════════════════════════════════════════════════════════════════
# Проверка yc CLI
# ═══════════════════════════════════════════════════════════════════

if ! command -v yc >/dev/null 2>&1; then
    echo -e "${RED}❌ yc CLI не установлен${NC}"
    echo
    echo "Установи командой:"
    echo "  curl -fsSL https://storage.yandexcloud.net/yandexcloud-yc/install.sh | bash"
    echo "  source ~/.bashrc"
    echo "  yc init"
    exit 1
fi

if ! yc config list >/dev/null 2>&1; then
    echo -e "${RED}❌ yc CLI не настроен${NC}"
    echo
    echo "Настрой командой: yc init"
    exit 1
fi

echo -e "${GREEN}✅ yc CLI настроен${NC}"
echo

# ═══════════════════════════════════════════════════════════════════
# Получение Folder ID
# ═══════════════════════════════════════════════════════════════════

echo -e "${CYAN}📁 Получаю Folder ID...${NC}"
FOLDER_ID=$(yc config get folder-id 2>/dev/null || echo "")

if [[ -z "$FOLDER_ID" ]]; then
    echo -e "${YELLOW}⚠️  Folder ID не найден в конфиге${NC}"
    echo "Получи его из веб-консоли Yandex Cloud"
    read -r -p "Введи Folder ID вручную: " FOLDER_ID
fi

echo -e "${GREEN}✅ Folder ID: $FOLDER_ID${NC}"
echo

# ═══════════════════════════════════════════════════════════════════
# Список VM
# ═══════════════════════════════════════════════════════════════════

echo -e "${CYAN}🖥️  Получаю список виртуальных машин...${NC}"
echo

if ! yc compute instance list --folder-id "$FOLDER_ID" --format json >/dev/null 2>&1; then
    echo -e "${RED}❌ Ошибка получения списка VM${NC}"
    echo "Возможные причины:"
    echo "  • Нет прав на просмотр VM"
    echo "  • Неверный Folder ID"
    echo "  • Нет VM в этой папке"
    exit 1
fi

VMS=$(yc compute instance list --folder-id "$FOLDER_ID" --format json)
VM_COUNT=$(echo "$VMS" | jq length)

if [[ "$VM_COUNT" -eq 0 ]]; then
    echo -e "${YELLOW}⚠️  VM не найдены в этой папке${NC}"
    exit 1
fi

echo -e "${GREEN}✅ Найдено VM: $VM_COUNT${NC}"
echo

# Показываем список VM
echo "┌────────────────────────────────────────────────────────────────┐"
echo "│                     ДОСТУПНЫЕ ВИРТУАЛЬНЫЕ МАШИНЫ                │"
echo "└────────────────────────────────────────────────────────────────┘"
echo

i=1
declare -A vm_map
while IFS= read -r vm; do
    name=$(echo "$vm" | jq -r '.name')
    id=$(echo "$vm" | jq -r '.id')
    status=$(echo "$vm" | jq -r '.status')
    ip=$(echo "$vm" | jq -r '.network_interfaces[0].primary_v4_address.one_to_one_nat.address // "нет внешнего IP"')
    zone=$(echo "$vm" | jq -r '.zone_id')
    
    vm_map[$i]="$id|$ip"
    
    echo -e "${BOLD}$i)${NC} ${CYAN}$name${NC}"
    echo "   ID:     $id"
    echo "   IP:     $ip"
    echo "   Статус: $status"
    echo "   Зона:   $zone"
    echo
    
    ((i++))
done < <(echo "$VMS" | jq -c '.[]')

# ═══════════════════════════════════════════════════════════════════
# Выбор VM
# ═══════════════════════════════════════════════════════════════════

read -r -p "Выбери номер VM для мониторинга: " choice

if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ -z "${vm_map[$choice]:-}" ]]; then
    echo -e "${RED}❌ Неверный выбор${NC}"
    exit 1
fi

IFS='|' read -r INSTANCE_ID VM_HOST <<< "${vm_map[$choice]}"

echo
echo -e "${GREEN}✅ Выбрана VM:${NC}"
echo "   Instance ID: $INSTANCE_ID"
echo "   VM Host:     $VM_HOST"
echo

# ═══════════════════════════════════════════════════════════════════
# Проверка Service Accounts
# ═══════════════════════════════════════════════════════════════════

echo -e "${CYAN}🔑 Проверяю Service Accounts...${NC}"

SAS=$(yc iam service-account list --folder-id "$FOLDER_ID" --format json 2>/dev/null || echo "[]")
SA_COUNT=$(echo "$SAS" | jq length)

if [[ "$SA_COUNT" -gt 0 ]]; then
    echo -e "${GREEN}✅ Найдено Service Accounts: $SA_COUNT${NC}"
    echo
    echo "Хочешь использовать существующий SA или создать новый?"
    echo "  1) Использовать существующий"
    echo "  2) Создать новый"
    read -r -p "Выбери: " sa_choice
    
    if [[ "$sa_choice" == "1" ]]; then
        echo
        echo "Доступные Service Accounts:"
        echo
        
        i=1
        declare -A sa_map
        while IFS= read -r sa; do
            name=$(echo "$sa" | jq -r '.name')
            id=$(echo "$sa" | jq -r '.id')
            created=$(echo "$sa" | jq -r '.created_at')
            
            sa_map[$i]="$id|$name"
            
            echo "$i) $name"
            echo "   ID: $id"
            echo "   Создан: $created"
            echo
            
            ((i++))
        done < <(echo "$SAS" | jq -c '.[]')
        
        read -r -p "Выбери номер SA: " sa_num
        
        if [[ ! "$sa_num" =~ ^[0-9]+$ ]] || [[ -z "${sa_map[$sa_num]:-}" ]]; then
            echo -e "${RED}❌ Неверный выбор${NC}"
            exit 1
        fi
        
        IFS='|' read -r SA_ID SA_NAME <<< "${sa_map[$sa_num]}"
        USE_EXISTING_SA=true
    else
        USE_EXISTING_SA=false
    fi
else
    echo -e "${YELLOW}⚠️  Service Accounts не найдены${NC}"
    USE_EXISTING_SA=false
fi

# ═══════════════════════════════════════════════════════════════════
# Создание или использование SA
# ═══════════════════════════════════════════════════════════════════

if [[ "$USE_EXISTING_SA" != "true" ]]; then
    echo
    echo -e "${CYAN}🔨 Создаю новый Service Account...${NC}"
    
    SA_NAME="watchdog-$(date +%s)"
    
    # Пытаемся создать SA
    CREATE_OUTPUT=$(yc iam service-account create \
        --name "$SA_NAME" \
        --folder-id "$FOLDER_ID" \
        --format json 2>&1) || {
        
        echo -e "${RED}❌ Не удалось создать Service Account${NC}"
        echo
        echo "Ошибка: $CREATE_OUTPUT"
        echo
        echo -e "${YELLOW}Возможные причины:${NC}"
        echo "  • Нет прав на создание SA (нужна роль iam.serviceAccounts.admin)"
        echo "  • Достигнут лимит SA в папке"
        echo
        echo -e "${CYAN}Решение:${NC}"
        echo "  1) Попроси администратора создать SA"
        echo "  2) Или выдать тебе права iam.serviceAccounts.admin"
        echo "  3) Используй веб-консоль: console.cloud.yandex.ru"
        echo
        exit 1
    }
    
    SA_ID=$(echo "$CREATE_OUTPUT" | jq -r '.id')
    echo -e "${GREEN}✅ Service Account создан: $SA_NAME ($SA_ID)${NC}"
    
    # Выдаём права
    echo -e "${CYAN}🔑 Выдаю права compute.operator...${NC}"
    
    yc resource-manager folder add-access-binding "$FOLDER_ID" \
        --role compute.operator \
        --subject "serviceAccount:$SA_ID" >/dev/null 2>&1 || {
        
        echo -e "${YELLOW}⚠️  Не удалось выдать права автоматически${NC}"
        echo "Выдай права вручную:"
        echo "  yc resource-manager folder add-access-binding $FOLDER_ID \\"
        echo "    --role compute.operator \\"
        echo "    --subject serviceAccount:$SA_ID"
    }
    
    echo -e "${GREEN}✅ Права выданы${NC}"
fi

# ═══════════════════════════════════════════════════════════════════
# Создание ключа
# ═══════════════════════════════════════════════════════════════════

echo
echo -e "${CYAN}🔐 Создаю авторизованный ключ...${NC}"

KEY_FILE="/tmp/watchdog-key-$(date +%s).json"

yc iam key create \
    --service-account-id "$SA_ID" \
    --output "$KEY_FILE" >/dev/null 2>&1 || {
    
    echo -e "${RED}❌ Не удалось создать ключ${NC}"
    echo "Попробуй создать вручную через веб-консоль"
    exit 1
}

echo -e "${GREEN}✅ Ключ создан: $KEY_FILE${NC}"

# ═══════════════════════════════════════════════════════════════════
# Итоговая информация
# ═══════════════════════════════════════════════════════════════════

echo
echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo -e "${BOLD}${GREEN}          ✅ ВСЕ ДАННЫЕ СОБРАНЫ УСПЕШНО!${NC}"
echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo

cat << EOF

📋 ДАННЫЕ ДЛЯ НАСТРОЙКИ:

┌─────────────────────────────────────────────────────────────────┐
│ VM_HOST (внешний IP VM)                                         │
│ ${GREEN}${VM_HOST}${NC}
│                                                                 │
│ INSTANCE_ID (ID виртуальной машины)                             │
│ ${GREEN}${INSTANCE_ID}${NC}
│                                                                 │
│ SA_KEY_FILE (путь к ключу Service Account)                     │
│ ${GREEN}${KEY_FILE}${NC}
│                                                                 │
│ Service Account                                                 │
│ ${GREEN}${SA_NAME} (${SA_ID})${NC}
└─────────────────────────────────────────────────────────────────┘

📝 ЧТО ДАЛЬШЕ:

1️⃣  Скопируй ключ на сервер:
   ${CYAN}scp $KEY_FILE root@ВАШ_СЕРВЕР:/opt/vps-watchdog/config/sa-key.json${NC}

2️⃣  На сервере открой конфиг:
   ${CYAN}sudo nano /opt/vps-watchdog/config/watchdog.env${NC}

3️⃣  Впиши эти данные:
   ${CYAN}VM_HOST=$VM_HOST
   INSTANCE_ID=$INSTANCE_ID${NC}

4️⃣  Перезапусти сервис:
   ${CYAN}sudo systemctl restart vps-watchdog${NC}

5️⃣  Проверь логи:
   ${CYAN}sudo docker logs -f vps-watchdog${NC}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

💾 Данные также сохранены в файл: watchdog-setup-data.txt

EOF

# Сохраняем в файл
cat > watchdog-setup-data.txt << EOF
VPS Watchdog - Данные для настройки
Создано: $(date)

VM_HOST=$VM_HOST
INSTANCE_ID=$INSTANCE_ID
SA_KEY_FILE=$KEY_FILE
SERVICE_ACCOUNT=$SA_NAME
SERVICE_ACCOUNT_ID=$SA_ID
FOLDER_ID=$FOLDER_ID
EOF

echo -e "${GREEN}✅ Готово!${NC}"
echo
