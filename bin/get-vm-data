#!/usr/bin/env bash
set -euo pipefail

# ═══════════════════════════════════════════════════════════════════
# VPS Watchdog - Автоматический сборщик данных (OAuth only)
# ═══════════════════════════════════════════════════════════════════

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo -e "${BOLD}${CYAN}  🔍 VPS Watchdog - Автоматический сбор данных${NC}"
echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo

# ═══════════════════════════════════════════════════════════════════
# Проверка зависимостей
# ═══════════════════════════════════════════════════════════════════

if ! command -v curl >/dev/null 2>&1; then
    echo -e "${RED}❌ curl не установлен${NC}"
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠️  jq не установлен, пытаюсь установить...${NC}"
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update -qq && sudo apt-get install -y -qq jq
    elif command -v yum >/dev/null 2>&1; then
        sudo yum install -y jq
    else
        echo -e "${RED}❌ Установи jq вручную: sudo apt-get install jq${NC}"
        exit 1
    fi
fi

# ═══════════════════════════════════════════════════════════════════
# OAuth авторизация
# ═══════════════════════════════════════════════════════════════════

echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo -e "${BOLD}${CYAN}  🌐 АВТОРИЗАЦИЯ ЧЕРЕЗ БРАУЗЕР${NC}"
echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo

echo -e "${YELLOW}📋 ИНСТРУКЦИЯ:${NC}"
echo
echo "1️⃣  Открой эту ссылку в браузере:"
echo
echo -e "${GREEN}${BOLD}https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb${NC}"
echo
echo "2️⃣  Авторизуйся в Yandex"
echo "3️⃣  Разреши доступ к Yandex Cloud"
echo "4️⃣  Скопируй токен который покажется на странице"
echo
echo -e "${YELLOW}⚠️  Токен выглядит примерно так:${NC}"
echo "   y0_AgAAAABabcdefghijklmnopqrstuvwxyz1234567890"
echo

read -r -p "Вставь токен сюда: " OAUTH_TOKEN

if [[ -z "$OAUTH_TOKEN" ]]; then
    echo -e "${RED}❌ Токен пустой${NC}"
    exit 1
fi

echo
echo -e "${GREEN}✅ Токен получен${NC}"

# Функция для API запросов с OAuth
yc_api() {
    local method="$1"
    local url="$2"
    local data="${3:-}"
    
    if [[ -n "$data" ]]; then
        curl -s -X "$method" \
            -H "Authorization: Bearer $OAUTH_TOKEN" \
            -H "Content-Type: application/json" \
            -d "$data" \
            "$url"
    else
        curl -s -X "$method" \
            -H "Authorization: Bearer $OAUTH_TOKEN" \
            "$url"
    fi
}

# Получаем список папок
echo
echo -e "${CYAN}📁 Получаю список папок (folders)...${NC}"

FOLDERS=$(yc_api GET "https://resource-manager.api.cloud.yandex.net/resource-manager/v1/folders" | jq -r '.folders // []')
FOLDER_COUNT=$(echo "$FOLDERS" | jq length)

if [[ "$FOLDER_COUNT" -eq 0 ]]; then
    echo -e "${RED}❌ Папки не найдены${NC}"
    echo "Возможно у токена нет прав или ты не авторизован"
    exit 1
fi

echo -e "${GREEN}✅ Найдено папок: $FOLDER_COUNT${NC}"
echo

# Показываем список папок
echo "┌────────────────────────────────────────────────────────────────┐"
echo "│                        ДОСТУПНЫЕ ПАПКИ                          │"
echo "└────────────────────────────────────────────────────────────────┘"
echo

i=1
declare -A folder_map
while IFS= read -r folder; do
    name=$(echo "$folder" | jq -r '.name')
    id=$(echo "$folder" | jq -r '.id')
    
    folder_map[$i]="$id"
    
    echo -e "${BOLD}$i)${NC} ${CYAN}$name${NC}"
    echo "   ID: $id"
    echo
    
    ((i++))
done < <(echo "$FOLDERS" | jq -c '.[]')

read -r -p "Выбери номер папки: " folder_choice

if [[ ! "$folder_choice" =~ ^[0-9]+$ ]] || [[ -z "${folder_map[$folder_choice]:-}" ]]; then
    echo -e "${RED}❌ Неверный выбор${NC}"
    exit 1
fi

FOLDER_ID="${folder_map[$folder_choice]}"
echo
echo -e "${GREEN}✅ Выбрана папка: $FOLDER_ID${NC}"

# Получаем список VM
echo
echo -e "${CYAN}🖥️  Получаю список виртуальных машин...${NC}"

VMS=$(yc_api GET "https://compute.api.cloud.yandex.net/compute/v1/instances?folderId=$FOLDER_ID")
VM_COUNT=$(echo "$VMS" | jq '.instances // [] | length')

if [[ "$VM_COUNT" -eq 0 ]]; then
    echo -e "${YELLOW}⚠️  VM не найдены в этой папке${NC}"
    echo
    echo "Возможные причины:"
    echo "  • VM действительно нет"
    echo "  • У токена нет прав на просмотр VM"
    echo
    echo "Создай VM через веб-консоль: https://console.cloud.yandex.ru"
    exit 1
fi

echo -e "${GREEN}✅ Найдено VM: $VM_COUNT${NC}"
echo

# Показываем список VM
echo "┌────────────────────────────────────────────────────────────────┐"
echo "│                     ДОСТУПНЫЕ ВИРТУАЛЬНЫЕ МАШИНЫ                │"
echo "└────────────────────────────────────────────────────────────────┘"
echo

i=1
declare -A vm_map
while IFS= read -r vm; do
    name=$(echo "$vm" | jq -r '.name')
    id=$(echo "$vm" | jq -r '.id')
    status=$(echo "$vm" | jq -r '.status')
    ip=$(echo "$vm" | jq -r '.networkInterfaces[0].primaryV4Address.oneToOneNat.address // "нет внешнего IP"')
    zone=$(echo "$vm" | jq -r '.zoneId')
    
    vm_map[$i]="$id|$ip"
    
    echo -e "${BOLD}$i)${NC} ${CYAN}$name${NC}"
    echo "   ID:     $id"
    echo "   IP:     $ip"
    echo "   Статус: $status"
    echo "   Зона:   $zone"
    echo
    
    ((i++))
done < <(echo "$VMS" | jq -c '.instances[]')

read -r -p "Выбери номер VM для мониторинга: " vm_choice

if [[ ! "$vm_choice" =~ ^[0-9]+$ ]] || [[ -z "${vm_map[$vm_choice]:-}" ]]; then
    echo -e "${RED}❌ Неверный выбор${NC}"
    exit 1
fi

IFS='|' read -r INSTANCE_ID VM_HOST <<< "${vm_map[$vm_choice]}"

echo
echo -e "${GREEN}✅ Выбрана VM:${NC}"
echo "   Instance ID: $INSTANCE_ID"
echo "   VM Host:     $VM_HOST"
echo

# Service Account через веб-консоль
echo -e "${CYAN}🔑 Service Account и ключ${NC}"
echo
echo -e "${YELLOW}⚠️  ВАЖНО:${NC}"
echo "Создай Service Account и ключ через веб-консоль:"
echo
echo "1️⃣  Открой: https://console.cloud.yandex.ru"
echo "2️⃣  Перейди: IAM → Service accounts → Создать"
echo "3️⃣  Имя: watchdog"
echo "4️⃣  Роль: compute.operator"
echo "5️⃣  Создай авторизованный ключ"
echo "6️⃣  Скачай JSON файл"
echo

SA_ID=""
KEY_FILE=""

# ═══════════════════════════════════════════════════════════════════
# Итоговая информация
# ═══════════════════════════════════════════════════════════════════

echo
echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo -e "${BOLD}${GREEN}          ✅ ДАННЫЕ СОБРАНЫ!${NC}"
echo -e "${BOLD}${CYAN}═══════════════════════════════════════════════════════════════════${NC}"
echo

cat << EOF

📋 ДАННЫЕ ДЛЯ НАСТРОЙКИ:

┌─────────────────────────────────────────────────────────────────┐
│ VM_HOST (внешний IP VM)                                         │
│ ${GREEN}${VM_HOST}${NC}
│                                                                 │
│ INSTANCE_ID (ID виртуальной машины)                             │
│ ${GREEN}${INSTANCE_ID}${NC}
│                                                                 │
│ SA_KEY_FILE                                                     │
│ ${YELLOW}Создай через веб-консоль (инструкция выше)${NC}
└─────────────────────────────────────────────────────────────────┘

📝 ЧТО ДАЛЬШЕ:

1️⃣  Создай Service Account через веб-консоль:
   ${CYAN}https://console.cloud.yandex.ru → IAM → Service accounts${NC}
   
   a) Создай SA с именем: watchdog
   b) Выдай роль: compute.operator
   c) Создай авторизованный ключ
   d) Скачай ключ
   e) Скопируй на ЭТОТ СЕРВЕР:
      scp ~/Downloads/key.json root@$(hostname -I | awk '{print $1}'):/opt/vps-watchdog/config/sa-key.json
      
      Или если уже на этом сервере:
      sudo cp ~/Downloads/key.json /opt/vps-watchdog/config/sa-key.json
      sudo chmod 600 /opt/vps-watchdog/config/sa-key.json

2️⃣  Открой конфиг:
   ${CYAN}sudo nano /opt/vps-watchdog/config/watchdog.env${NC}

3️⃣  Впиши эти данные:
   ${CYAN}VM_HOST=$VM_HOST
   INSTANCE_ID=$INSTANCE_ID${NC}

4️⃣  Перезапусти:
   ${CYAN}sudo systemctl restart vps-watchdog${NC}

5️⃣  Проверь логи:
   ${CYAN}sudo docker logs -f vps-watchdog${NC}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

💾 Данные сохранены в: watchdog-setup-data.txt

EOF

# Сохраняем в файл
cat > watchdog-setup-data.txt << EOF
VPS Watchdog - Данные для настройки
Создано: $(date)
Метод авторизации: OAuth токен

VM_HOST=$VM_HOST
INSTANCE_ID=$INSTANCE_ID
FOLDER_ID=$FOLDER_ID

Создай Service Account через веб-консоль:
https://console.cloud.yandex.ru → IAM → Service accounts
EOF

echo -e "${GREEN}✅ Готово!${NC}"
