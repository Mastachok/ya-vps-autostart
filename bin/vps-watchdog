#!/usr/bin/env bash
set -euo pipefail

# ═══════════════════════════════════════════════════════════════════
# VPS WATCHDOG v3.0.1-SA - Интерактивное меню (Service Account)
# ═══════════════════════════════════════════════════════════════════

VERSION="3.0.1-SA"
CONFIG_DIR="/opt/vps-watchdog/config"
PROFILES_DIR="/opt/vps-watchdog/profiles"
DATA_DIR="/opt/vps-watchdog/data"
SA_KEY_FILE="$CONFIG_DIR/sa-key.json"
TELEGRAM_CONFIG="$CONFIG_DIR/telegram.json"
SERVICE="vps-watchdog"

# Цвета
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
GRAY='\033[0;90m'
NC='\033[0m'

# Вспомогательные функции
title() { echo -e "${CYAN}${BOLD}$1${NC}"; }
success() { echo -e "${GREEN}✅ $1${NC}"; }
error() { echo -e "${RED}❌ $1${NC}"; }
warn() { echo -e "${YELLOW}⚠️  $1${NC}"; }
info() { echo -e "${BLUE}ℹ️  $1${NC}"; }
hr() { echo -e "${GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"; }
pause() { echo; read -r -p "Нажми Enter для продолжения..."; }

count_profiles() {
    mkdir -p "$PROFILES_DIR" 2>/dev/null || true
    local total=$(find "$PROFILES_DIR" -maxdepth 1 -name "*.json" -type f 2>/dev/null | wc -l)
    local enabled=0
    
    if command -v jq >/dev/null 2>&1; then
        for file in "$PROFILES_DIR"/*.json 2>/dev/null; do
            [[ -f "$file" ]] || continue
            if jq -e '.enabled == true' "$file" >/dev/null 2>&1; then
                ((enabled++)) || true
            fi
        done
    fi
    echo "$total $enabled"
}

get_service_status() {
    if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
        echo -e "${GREEN}работает${NC}"
    else
        echo -e "${RED}остановлен${NC}"
    fi
}

get_telegram_status() {
    if [[ -f "$TELEGRAM_CONFIG" ]]; then
        if jq -e '.enabled == true' "$TELEGRAM_CONFIG" >/dev/null 2>&1; then
            echo -e "${GREEN}настроен${NC}"
        else
            echo -e "${YELLOW}выключен${NC}"
        fi
    else
        echo -e "${GRAY}не настроен${NC}"
    fi
}

check_sa_key() {
    if [[ -f "$SA_KEY_FILE" ]]; then
        echo -e "${GREEN}настроен${NC}"
    else
        echo -e "${YELLOW}не найден${NC}"
    fi
}

# ═══════════════════════════════════════════════════════════════════
# ГЛАВНОЕ МЕНЮ
# ═══════════════════════════════════════════════════════════════════

main_menu() {
    while true; do
        clear
        read -r total enabled <<< "$(count_profiles)"
        
        title "═══════════════════════════════════════════════════════════════"
        title "           🛡️  VPS WATCHDOG v${VERSION}                        "
        title "═══════════════════════════════════════════════════════════════"
        echo
        
        info "📊 СТАТУС:"
        echo -e "   📝 Профилей: ${BOLD}$total${NC} (активных: ${GREEN}$enabled${NC})"
        echo -e "   ⚙️  Сервис: $(get_service_status)"
        echo -e "   📱 Telegram: $(get_telegram_status)"
        echo -e "   🔑 SA ключ: $(check_sa_key)"
        
        hr
        echo
        
        echo -e "${BOLD}📋 УПРАВЛЕНИЕ ПРОФИЛЯМИ:${NC}"
        echo "  1) 📝 Список профилей"
        echo "  2) ➕ Добавить профиль"
        echo "  3) ✏️  Редактировать профиль"
        echo "  4) 🗑️  Удалить профиль"
        echo "  5) 🔄 Включить/выключить мониторинг"
        echo
        
        echo -e "${BOLD}📱 TELEGRAM:${NC}"
        echo "  6) 🤖 Настроить бота"
        echo "  7) 📤 Тест уведомления"
        echo "  8) 📊 Статус бота"
        echo
        
        echo -e "${BOLD}⚙️  СИСТЕМА:${NC}"
        echo "  9) 🔧 Управление сервисом"
        echo "  10) 📜 Показать логи"
        echo "  11) 📊 Статистика"
        echo
        
        echo -e "${BOLD}🔐 SERVICE ACCOUNT:${NC}"
        echo "  12) 📥 Загрузить SA ключ"
        echo "  13) 🔍 Проверить SA ключ"
        echo
        
        echo -e "${BOLD}ℹ️  ИНФОРМАЦИЯ:${NC}"
        echo "  0) ❓ Помощь"
        echo "  q) 🚪 Выход"
        echo
        
        read -r -p "Выбери пункт: " choice
        
        case "$choice" in
            1) list_profiles ;;
            2) add_profile ;;
            3) edit_profile ;;
            4) delete_profile ;;
            5) toggle_profile ;;
            6) setup_telegram ;;
            7) test_telegram ;;
            8) telegram_status ;;
            9) manage_service ;;
            10) show_logs ;;
            11) show_stats ;;
            12) upload_sa_key ;;
            13) verify_sa_key ;;
            0) show_help ;;
            q|Q) exit 0 ;;
            *) error "Неверный выбор"; pause ;;
        esac
    done
}

# ═══════════════════════════════════════════════════════════════════
# SA КЛЮЧ
# ═══════════════════════════════════════════════════════════════════

upload_sa_key() {
    clear
    title "📥 ЗАГРУЗКА SERVICE ACCOUNT КЛЮЧА"
    hr
    echo
    
    info "Выбери способ:"
    echo "  1) 📝 Открыть в nano и вставить"
    echo "  2) 📋 Инструкция по созданию SA"
    echo "  3) 🔙 Назад"
    echo
    
    read -r -p "Выбор: " method
    
    case "$method" in
        1)
            mkdir -p "$CONFIG_DIR"
            info "Открываю редактор..."
            nano "$SA_KEY_FILE"
            
            if [[ -f "$SA_KEY_FILE" ]] && [[ -s "$SA_KEY_FILE" ]]; then
                chmod 600 "$SA_KEY_FILE"
                if python3 -m json.tool "$SA_KEY_FILE" >/dev/null 2>&1; then
                    success "SA ключ сохранён!"
                else
                    error "JSON некорректный"
                fi
            fi
            ;;
        2)
            clear
            title "📝 КАК СОЗДАТЬ SERVICE ACCOUNT КЛЮЧ"
            hr
            echo
            echo "1️⃣  Открой: https://console.yandex.cloud/"
            echo "2️⃣  IAM → Service accounts → Create"
            echo "3️⃣  Имя: vps-watchdog-sa"
            echo "4️⃣  Роль: compute.admin"
            echo "5️⃣  Нажми Create"
            echo "6️⃣  Keys → Create new key → Create authorized key"
            echo "7️⃣  Формат: JSON → Create"
            echo "8️⃣  Скачай файл key.json"
            echo
            info "Затем:"
            echo "  - Открой key.json на компьютере"
            echo "  - Скопируй весь текст (Ctrl+A, Ctrl+C)"
            echo "  - Вернись в это меню → пункт 1"
            echo "  - Вставь в nano (правая кнопка мыши)"
            echo "  - Ctrl+O, Enter, Ctrl+X"
            ;;
        *)
            return
            ;;
    esac
    
    pause
}

verify_sa_key() {
    clear
    title "🔍 ПРОВЕРКА SA КЛЮЧА"
    hr
    echo
    
    if [[ ! -f "$SA_KEY_FILE" ]]; then
        error "SA ключ не найден!"
        warn "Создай через пункт 12"
        pause
        return
    fi
    
    success "Файл найден: $SA_KEY_FILE"
    echo
    
    if python3 -m json.tool "$SA_KEY_FILE" >/dev/null 2>&1; then
        success "JSON валидный"
        echo
        
        if command -v jq >/dev/null 2>&1; then
            info "Информация:"
            echo "  ID: $(jq -r '.id // "N/A"' "$SA_KEY_FILE")"
            echo "  SA ID: $(jq -r '.service_account_id // "N/A"' "$SA_KEY_FILE")"
        fi
        echo "  Размер: $(wc -c < "$SA_KEY_FILE") байт"
        echo "  Права: $(stat -c %a "$SA_KEY_FILE")"
        
        if [[ "$(stat -c %a "$SA_KEY_FILE")" != "600" ]]; then
            chmod 600 "$SA_KEY_FILE"
            success "Права исправлены на 600"
        fi
    else
        error "JSON некорректный!"
    fi
    
    pause
}

# ═══════════════════════════════════════════════════════════════════
# ДОБАВЛЕНИЕ ПРОФИЛЯ (упрощённая версия)
# ═══════════════════════════════════════════════════════════════════

add_profile() {
    clear
    title "➕ ДОБАВЛЕНИЕ ПРОФИЛЯ VM"
    hr
    echo
    
    # Проверяем SA ключ
    if [[ ! -f "$SA_KEY_FILE" ]]; then
        error "SA ключ не найден!"
        warn "Сначала добавь SA ключ (пункт 12)"
        pause
        return
    fi
    
    info "Введи данные VM:"
    echo
    
    read -r -p "Имя VM: " vm_name
    [[ -z "$vm_name" ]] && { error "Имя пустое"; pause; return; }
    
    read -r -p "IP адрес: " vm_host
    [[ -z "$vm_host" ]] && { error "IP пустой"; pause; return; }
    
    read -r -p "Instance ID: " instance_id
    [[ -z "$instance_id" ]] && { error "ID пустой"; pause; return; }
    
    read -r -p "Folder ID: " folder_id
    [[ -z "$folder_id" ]] && { error "Folder ID пустой"; pause; return; }
    
    echo
    info "💾 Создаю профиль..."
    
    profile_id=$(head /dev/urandom | tr -dc a-z0-9 | head -c 8)
    profile_file="$PROFILES_DIR/${profile_id}.json"
    
    mkdir -p "$PROFILES_DIR"
    
    cat > "$profile_file" <<PROFEOF
{
  "id": "${profile_id}",
  "name": "${vm_name}",
  "vm_host": "${vm_host}",
  "instance_id": "${instance_id}",
  "folder_id": "${folder_id}",
  "enabled": true,
  "check_interval": 60,
  "ping_count": 3,
  "ping_timeout": 5,
  "cooldown_minutes": 5,
  "max_start_attempts": 3,
  "created_at": "$(date -Iseconds)",
  "updated_at": "$(date -Iseconds)"
}
PROFEOF
    
    if [[ -f "$profile_file" ]]; then
        success "Профиль создан!"
        echo
        python3 -m json.tool "$profile_file" 2>/dev/null || cat "$profile_file"
        echo
        
        info "🔄 Перезапускаю сервис..."
        systemctl restart "$SERVICE" &>/dev/null &
        success "Готово!"
    fi
    
    pause
}
    for file in "$PROFILES_DIR"/*.json; do
        [[ -f "$file" ]] || continue
        
        local name=$(jq -r '.name' "$file")
        local vm_host=$(jq -r '.vm_host' "$file")
        local instance_id=$(jq -r '.instance_id' "$file")
        local enabled=$(jq -r '.enabled' "$file")
        local check_interval=$(jq -r '.check_interval' "$file")
        
        local status_icon="🔴"
        local status_text="выключен"
        if [[ "$enabled" == "true" ]]; then
            status_icon="🟢"
            status_text="${GREEN}включен${NC}"
        fi
        
        echo -e "${BOLD}$i) $status_icon $name${NC}"
        echo "   IP:       $vm_host"
        echo "   ID:       ${instance_id:0:20}..."
        echo -e "   Статус:   $status_text"
        echo "   Интервал: ${check_interval}с"
        echo
        
        ((i++))
    done
    
    hr
    pause
}

    success "Профиль создан: $profile_file"
    
    # Показываем содержимое
    echo
    info "Содержимое профиля:"
    cat "$profile_file" | jq .
    echo
    
    # Перезапускаем сервис в фоне
    info "🔄 Перезапускаю сервис..."
    systemctl restart "$SERVICE" &>/dev/null &
    
    success "Готово! Профиль добавлен!"
    info "Проверь логи: sudo docker logs -f vps-watchdog"
    echo
    info "Проверь логи: sudo docker logs -f vps-watchdog"
    
    pause
}



# ═══════════════════════════════════════════════════════════════════
# РЕДАКТИРОВАНИЕ/УДАЛЕНИЕ ПРОФИЛЕЙ
# ═══════════════════════════════════════════════════════════════════

edit_profile() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                   ✏️  РЕДАКТИРОВАТЬ ПРОФИЛЬ                    "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -d "$PROFILES_DIR" ]] || [[ -z "$(ls -A "$PROFILES_DIR"/*.json 2>/dev/null)" ]]; then
        warn "Нет профилей"
        pause
        return
    fi
    
    # Показываем список
    local i=1
    declare -A profile_files
    for file in "$PROFILES_DIR"/*.json; do
        [[ -f "$file" ]] || continue
        local name=$(jq -r '.name' "$file")
        profile_files[$i]="$file"
        echo -e "${BOLD}$i)${NC} $name"
        ((i++))
    done
    
    echo "0) Назад"
    echo
    read -r -p "Выбери профиль: " choice
    
    if [[ "$choice" == "0" ]]; then
        return
    fi
    
    if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ -z "${profile_files[$choice]:-}" ]]; then
        error "Неверный выбор"
        pause
        return
    fi
    
    local file="${profile_files[$choice]}"
    
    # Редактируем
    echo
    info "Редактирование: $(jq -r '.name' "$file")"
    echo
    
    read -r -p "Новое имя [Enter - оставить]: " new_name
    read -r -p "Интервал проверки в секундах [Enter - оставить]: " new_interval
    read -r -p "Cooldown в минутах [Enter - оставить]: " new_cooldown
    
    # Обновляем
    local tmp_file=$(mktemp)
    jq "$(
        echo '.'
        [[ -n "$new_name" ]] && echo "| .name = \"$new_name\""
        [[ -n "$new_interval" ]] && echo "| .check_interval = $new_interval"
        [[ -n "$new_cooldown" ]] && echo "| .cooldown_minutes = $new_cooldown"
        echo "| .updated_at = \"$(date -Iseconds)\""
    )" "$file" > "$tmp_file"
    
    mv "$tmp_file" "$file"
    
    success "Профиль обновлён!"
    systemctl restart "$SERVICE"
    pause
}

delete_profile() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                     🗑️  УДАЛИТЬ ПРОФИЛЬ                       "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -d "$PROFILES_DIR" ]] || [[ -z "$(ls -A "$PROFILES_DIR"/*.json 2>/dev/null)" ]]; then
        warn "Нет профилей"
        pause
        return
    fi
    
    # Показываем список
    local i=1
    declare -A profile_files
    for file in "$PROFILES_DIR"/*.json; do
        [[ -f "$file" ]] || continue
        local name=$(jq -r '.name' "$file")
        profile_files[$i]="$file"
        echo -e "${BOLD}$i)${NC} $name"
        ((i++))
    done
    
    echo "0) Назад"
    echo
    read -r -p "Выбери профиль для удаления: " choice
    
    if [[ "$choice" == "0" ]]; then
        return
    fi
    
    if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ -z "${profile_files[$choice]:-}" ]]; then
        error "Неверный выбор"
        pause
        return
    fi
    
    local file="${profile_files[$choice]}"
    local name=$(jq -r '.name' "$file")
    
    echo
    warn "Удалить профиль '$name'?"
    read -r -p "(yes/no): " confirm
    
    if [[ "$confirm" == "yes" ]]; then
        rm "$file"
        success "Профиль удалён!"
        systemctl restart "$SERVICE"
    else
        info "Отменено"
    fi
    
    pause
}

toggle_profile() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "              🔄 ВКЛЮЧИТЬ/ВЫКЛЮЧИТЬ МОНИТОРИНГ                 "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -d "$PROFILES_DIR" ]] || [[ -z "$(ls -A "$PROFILES_DIR"/*.json 2>/dev/null)" ]]; then
        warn "Нет профилей"
        pause
        return
    fi
    
    # Показываем список
    local i=1
    declare -A profile_files
    for file in "$PROFILES_DIR"/*.json; do
        [[ -f "$file" ]] || continue
        local name=$(jq -r '.name' "$file")
        local enabled=$(jq -r '.enabled' "$file")
        local status="🔴 выключен"
        [[ "$enabled" == "true" ]] && status="🟢 включен"
        profile_files[$i]="$file"
        echo -e "${BOLD}$i)${NC} $name ($status)"
        ((i++))
    done
    
    echo "0) Назад"
    echo
    read -r -p "Выбери профиль: " choice
    
    if [[ "$choice" == "0" ]]; then
        return
    fi
    
    if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ -z "${profile_files[$choice]:-}" ]]; then
        error "Неверный выбор"
        pause
        return
    fi
    
    local file="${profile_files[$choice]}"
    local current=$(jq -r '.enabled' "$file")
    local new_state="false"
    [[ "$current" == "false" ]] && new_state="true"
    
    jq ".enabled = $new_state | .updated_at = \"$(date -Iseconds)\"" "$file" > "$file.tmp"
    mv "$file.tmp" "$file"
    
    if [[ "$new_state" == "true" ]]; then
        success "Мониторинг включен!"
    else
        success "Мониторинг выключен!"
    fi
    
    systemctl restart "$SERVICE"
    pause
}

# ═══════════════════════════════════════════════════════════════════
# TELEGRAM
# ═══════════════════════════════════════════════════════════════════

setup_telegram() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                   🤖 НАСТРОЙКА TELEGRAM БОТА                   "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    info "📋 ИНСТРУКЦИЯ:"
    echo
    echo "1️⃣  Создай бота через @BotFather в Telegram"
    echo "   • Отправь команду: /newbot"
    echo "   • Придумай имя бота"
    echo "   • Скопируй токен (выглядит так: 123456:ABC-DEF...)"
    echo
    echo "2️⃣  Получи Chat ID"
    echo "   • Напиши своему боту любое сообщение"
    echo "   • Открой: https://api.telegram.org/botТВОЙ_ТОКЕН/getUpdates"
    echo "   • Найди \"chat\":{\"id\":123456789"
    echo
    hr
    echo
    
    read -r -p "Bot Token: " bot_token
    
    if [[ -z "$bot_token" ]]; then
        error "Токен пустой"
        pause
        return
    fi
    
    read -r -p "Chat ID: " chat_id
    
    if [[ -z "$chat_id" ]]; then
        error "Chat ID пустой"
        pause
        return
    fi
    
    # Тестируем подключение
    info "🔄 Проверяю подключение..."
    
    response=$(curl -s "https://api.telegram.org/bot${bot_token}/getMe")
    
    if echo "$response" | jq -e '.ok == true' >/dev/null 2>&1; then
        bot_username=$(echo "$response" | jq -r '.result.username')
        success "Бот подключен: @$bot_username"
        
        # Сохраняем конфиг
        mkdir -p "$CONFIG_DIR"
        cat > "$TELEGRAM_CONFIG" <<EOF
{
  "bot_token": "$bot_token",
  "chat_id": "$chat_id",
  "enabled": true,
  "notify_on_down": true,
  "notify_on_up": true,
  "notify_on_error": true,
  "notify_on_start": false
}
EOF
        
        success "Конфигурация сохранена!"
        
        # Отправляем тестовое сообщение
        curl -s -X POST "https://api.telegram.org/bot${bot_token}/sendMessage" \
            -d "chat_id=${chat_id}" \
            -d "text=🛡️ <b>VPS Watchdog подключен!</b>%0A%0AУведомления активированы." \
            -d "parse_mode=HTML" >/dev/null
        
        success "Тестовое сообщение отправлено!"
        
        # Перезапускаем сервис
        systemctl restart "$SERVICE"
        
    else
        error "Не удалось подключиться к боту"
        echo "Проверь Bot Token"
    fi
    
    pause
}

test_telegram() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                   📤 ТЕСТ УВЕДОМЛЕНИЯ                         "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -f "$TELEGRAM_CONFIG" ]]; then
        error "Telegram не настроен"
        info "Настрой бота через пункт 6"
        pause
        return
    fi
    
    bot_token=$(jq -r '.bot_token' "$TELEGRAM_CONFIG")
    chat_id=$(jq -r '.chat_id' "$TELEGRAM_CONFIG")
    
    info "Отправляю тестовое уведомление..."
    
    message="🧪 <b>Тестовое уведомление</b>%0A%0A⏰ Время: $(date '+%d.%m.%Y %H:%M:%S')%0A✅ Telegram работает!"
    
    response=$(curl -s -X POST "https://api.telegram.org/bot${bot_token}/sendMessage" \
        -d "chat_id=${chat_id}" \
        -d "text=${message}" \
        -d "parse_mode=HTML")
    
    if echo "$response" | jq -e '.ok == true' >/dev/null 2>&1; then
        success "Сообщение отправлено!"
    else
        error "Ошибка отправки"
        echo "$response" | jq .
    fi
    
    pause
}

telegram_status() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                     📊 СТАТУС TELEGRAM                        "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -f "$TELEGRAM_CONFIG" ]]; then
        error "Telegram не настроен"
        pause
        return
    fi
    
    bot_token=$(jq -r '.bot_token' "$TELEGRAM_CONFIG")
    chat_id=$(jq -r '.chat_id' "$TELEGRAM_CONFIG")
    enabled=$(jq -r '.enabled' "$TELEGRAM_CONFIG")
    
    response=$(curl -s "https://api.telegram.org/bot${bot_token}/getMe")
    
    if echo "$response" | jq -e '.ok == true' >/dev/null 2>&1; then
        bot_username=$(echo "$response" | jq -r '.result.username')
        bot_name=$(echo "$response" | jq -r '.result.first_name')
        
        echo -e "${GREEN}✅ Бот подключен${NC}"
        echo
        echo "   Имя:      $bot_name"
        echo "   Username: @$bot_username"
        echo "   Chat ID:  $chat_id"
        echo -e "   Статус:   $([ "$enabled" == "true" ] && echo "${GREEN}включен${NC}" || echo "${RED}выключен${NC}")"
        echo
        
        info "Настройки уведомлений:"
        echo "   🔴 VM упала:       $(jq -r '.notify_on_down' "$TELEGRAM_CONFIG")"
        echo "   🟢 VM запущена:    $(jq -r '.notify_on_up' "$TELEGRAM_CONFIG")"
        echo "   ⚠️  Ошибки:         $(jq -r '.notify_on_error' "$TELEGRAM_CONFIG")"
        
    else
        error "Бот недоступен"
    fi
    
    pause
}

# ═══════════════════════════════════════════════════════════════════
# УПРАВЛЕНИЕ OAUTH
# ═══════════════════════════════════════════════════════════════════

manage_oauth() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                🔑 УПРАВЛЕНИЕ OAUTH ТОКЕНОМ                    "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    oauth_file="$CONFIG_DIR/oauth-token.txt"
    
    # Проверяем наличие токена
    if [[ -f "$oauth_file" ]]; then
        oauth_token=$(cat "$oauth_file" 2>/dev/null)
        token_preview="${oauth_token:0:20}...${oauth_token: -10}"
        
        success "OAuth токен найден"
        echo "   Файл: $oauth_file"
        echo "   Токен: $token_preview"
        echo
        
        # Проверяем валидность токена
        info "🔄 Проверяю валидность токена..."
        
        iam_response=$(curl -s -X POST \
            -H "Content-Type: application/json" \
            -d "{\"yandexPassportOauthToken\": \"$oauth_token\"}" \
            "https://iam.api.cloud.yandex.net/iam/v1/tokens")
        
        if echo "$iam_response" | jq -e '.iamToken' >/dev/null 2>&1; then
            success "✅ Токен валиден"
        else
            error "❌ Токен невалиден или истёк"
            echo
            warn "Возможные причины:"
            echo "   • Токен устарел (срок действия OAuth токенов ограничен)"
            echo "   • Токен был отозван в настройках аккаунта"
            echo "   • Проблемы с интернет-соединением"
        fi
        
        echo
        hr
        echo
        echo "  1) 🔄 Обновить токен"
        echo "  2) 🗑️  Удалить токен"
        echo "  3) 👁️  Показать полный токен"
        echo "  0) ← Назад"
        echo
        
        read -r -p "Выбери: " choice
        
        case $choice in
            1)
                info "🌐 Получение нового OAuth токена"
                echo
                echo "Открой эту ссылку в браузере:"
                echo
                echo -e "${GREEN}${BOLD}https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb${NC}"
                echo
                read -r -p "Вставь новый OAuth токен: " new_token
                
                if [[ -n "$new_token" ]]; then
                    echo "$new_token" > "$oauth_file"
                    chmod 600 "$oauth_file"
                    success "Токен обновлён!"
                    
                    # Перезапускаем сервис
                    info "🔄 Перезапускаю сервис..."
                    systemctl restart "$SERVICE" &>/dev/null &
                    success "Сервис перезапускается"
                else
                    error "Токен пустой"
                fi
                pause
                ;;
            2)
                warn "Удалить OAuth токен?"
                echo "   ⚠️  После удаления потребуется новая авторизация"
                echo
                read -r -p "(yes/no): " confirm
                
                if [[ "$confirm" == "yes" ]]; then
                    rm -f "$oauth_file"
                    success "Токен удалён"
                else
                    info "Отменено"
                fi
                pause
                ;;
            3)
                echo
                info "Полный OAuth токен:"
                echo
                echo -e "${CYAN}$oauth_token${NC}"
                echo
                warn "⚠️  Не делись этим токеном!"
                pause
                ;;
            0)
                return
                ;;
            *)
                warn "Неверный выбор"
                pause
                ;;
        esac
    else
        warn "OAuth токен не найден"
        echo
        info "Токен будет создан автоматически при добавлении первого профиля"
        echo "   через пункт меню: 2) ➕ Добавить профиль (OAuth)"
        echo
        hr
        echo
        echo "  1) 🔑 Добавить OAuth токен вручную"
        echo "  0) ← Назад"
        echo
        
        read -r -p "Выбери: " choice
        
        case $choice in
            1)
                info "🌐 Получение OAuth токена"
                echo
                echo "Открой эту ссылку в браузере:"
                echo
                echo -e "${GREEN}${BOLD}https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb${NC}"
                echo
                read -r -p "Вставь OAuth токен: " new_token
                
                if [[ -n "$new_token" ]]; then
                    mkdir -p "$CONFIG_DIR"
                    echo "$new_token" > "$oauth_file"
                    chmod 600 "$oauth_file"
                    success "Токен сохранён!"
                else
                    error "Токен пустой"
                fi
                pause
                ;;
            0)
                return
                ;;
            *)
                warn "Неверный выбор"
                pause
                ;;
        esac
    fi
}

# ═══════════════════════════════════════════════════════════════════
# УПРАВЛЕНИЕ СЕРВИСОМ
# ═══════════════════════════════════════════════════════════════════

service_menu() {
    while true; do
        clear
        title "═══════════════════════════════════════════════════════════════"
        title "                   🔧 УПРАВЛЕНИЕ СЕРВИСОМ                      "
        title "═══════════════════════════════════════════════════════════════"
        echo
        
        echo "  1) ▶️  Запустить"
        echo "  2) ⏹️  Остановить"
        echo "  3) 🔄 Перезапустить"
        echo "  4) 📊 Статус"
        echo "  0) ← Назад"
        echo
        
        read -r -p "Выбери: " choice
        
        case $choice in
            1) systemctl start "$SERVICE"; success "Сервис запущен"; pause ;;
            2) systemctl stop "$SERVICE"; success "Сервис остановлен"; pause ;;
            3) systemctl restart "$SERVICE"; success "Сервис перезапущен"; pause ;;
            4) systemctl status "$SERVICE"; pause ;;
            0) return ;;
            *) warn "Неверный выбор"; pause ;;
        esac
    done
}

show_logs() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                         📜 ЛОГИ                               "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    # Ищем имя контейнера (может быть vps-watchdog, vps-watchdog-app-1, и т.д.)
    local container_name=$(docker ps --format "{{.Names}}" 2>/dev/null | grep -i vps-watchdog | head -1)
    
    if [[ -z "$container_name" ]]; then
        # Проверяем остановленные контейнеры
        container_name=$(docker ps -a --format "{{.Names}}" 2>/dev/null | grep -i vps-watchdog | head -1)
        
        if [[ -z "$container_name" ]]; then
            error "Контейнер VPS Watchdog не найден"
            echo
            info "Проверь что сервис запущен:"
            echo "   sudo systemctl status vps-watchdog"
        else
            warn "Контейнер найден, но он остановлен: $container_name"
            echo
            info "Показываю последние логи:"
            echo
            docker logs --tail 50 "$container_name" 2>&1
        fi
    else
        info "Контейнер: $container_name"
        echo
        docker logs --tail 50 "$container_name" 2>&1
    fi
    
    pause
}


# ═══════════════════════════════════════════════════════════════════
# SERVICE ACCOUNT FUNCTIONS
# ═══════════════════════════════════════════════════════════════════

upload_sa_key() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "           📤 ЗАГРУЗКА SERVICE ACCOUNT КЛЮЧА"
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    # Проверка существующего ключа
    if [[ -f "$CONFIG_DIR/sa-key.json" ]]; then
        warn "⚠️  SA ключ уже существует!"
        echo
        info "Текущий SA ID:"
        cat "$CONFIG_DIR/sa-key.json" | jq -r '.service_account_id' 2>/dev/null || echo "Невозможно прочитать"
        echo
        echo "Хочешь заменить существующий ключ? (yes/no)"
        read -r confirm
        [[ "$confirm" != "yes" ]] && return
    fi
    
    echo
    info "📚 Как получить Service Account ключ:"
    echo
    echo "1️⃣  Открой Yandex Cloud Console:"
    echo "    ${CYAN}https://console.cloud.yandex.ru/${NC}"
    echo
    echo "2️⃣  Перейди: ${BOLD}Сервисные аккаунты → Создать${NC} (если нет)"
    echo
    echo "3️⃣  ${RED}ВАЖНО!${NC} Назначь роль: ${GREEN}compute.operator${NC}"
    echo
    echo "4️⃣  Открой SA → Ключи → Создать авторизованный ключ"
    echo
    echo "5️⃣  Скачай JSON файл"
    echo
    
    pause
    clear
    
    title "═══════════════════════════════════════════════════════════════"
    title "           📋 ВСТАВКА КЛЮЧА"
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    info "Сейчас откроется редактор nano."
    info "Вставь ВЕСЬ текст из скачанного JSON файла."
    echo
    warn "ВАЖНО:"
    echo "  • Вставляй весь JSON целиком (от { до })"
    echo "  • Не добавляй пробелы в начале/конце"
    echo "  • Сохрани: Ctrl+X, затем Y, затем Enter"
    echo
    
    pause
    
    # Создаём временный файл
    tmp_file=$(mktemp)
    
    # Открываем nano
    nano "$tmp_file"
    
    # Проверка что файл не пустой
    if [[ ! -s "$tmp_file" ]]; then
        error "❌ Файл пустой! Ключ не загружен."
        rm -f "$tmp_file"
        pause
        return
    fi
    
    # Проверка валидности JSON
    if ! jq . "$tmp_file" >/dev/null 2>&1; then
        error "❌ Невалидный JSON!"
        echo
        warn "Проверь что скопировал весь текст из файла."
        warn "JSON должен начинаться с { и заканчиваться на }"
        rm -f "$tmp_file"
        pause
        return
    fi
    
    # Проверка что это SA ключ
    if ! jq -e '.service_account_id' "$tmp_file" >/dev/null 2>&1; then
        error "❌ Это не Service Account ключ!"
        echo
        warn "В файле должно быть поле 'service_account_id'"
        rm -f "$tmp_file"
        pause
        return
    fi
    
    # Создаём директорию если нет
    mkdir -p "$CONFIG_DIR"
    
    # Сохраняем ключ
    mv "$tmp_file" "$CONFIG_DIR/sa-key.json"
    chmod 600 "$CONFIG_DIR/sa-key.json"
    
    echo
    success "✅ SA ключ успешно загружен!"
    echo
    
    # Показываем информацию
    info "📋 Информация о ключе:"
    echo
    echo "  Service Account ID:"
    echo "    $(cat "$CONFIG_DIR/sa-key.json" | jq -r '.service_account_id')"
    echo
    echo "  Key ID:"
    echo "    $(cat "$CONFIG_DIR/sa-key.json" | jq -r '.id')"
    echo
    
    # Перезапуск сервиса
    if systemctl is-active --quiet "$SERVICE"; then
        echo
        info "🔄 Перезапускаю сервис..."
        systemctl restart "$SERVICE"
        sleep 2
        
        if systemctl is-active --quiet "$SERVICE"; then
            success "Сервис перезапущен!"
        else
            error "Ошибка перезапуска. Проверь логи: sudo docker logs vps-watchdog"
        fi
    fi
    
    echo
    success "Готово! SA ключ настроен."
    echo
    info "Теперь VPS Watchdog сможет запускать VM!"
    
    pause
}

check_sa_key() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "           🔍 ПРОВЕРКА SERVICE ACCOUNT КЛЮЧА"
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -f "$CONFIG_DIR/sa-key.json" ]]; then
        error "❌ SA ключ НЕ НАЙДЕН!"
        echo
        warn "Без SA ключа VPS Watchdog НЕ СМОЖЕТ запускать VM!"
        echo
        info "Загрузи SA ключ через главное меню (пункт: Загрузить SA ключ)"
        echo
        info "Или через команду:"
        echo "  sudo nano /opt/vps-watchdog/config/sa-key.json"
        echo
        info "📚 Подробная инструкция:"
        echo "  https://github.com/Mastachok/ya-vps-autostart/blob/main/docs/SERVICE_ACCOUNT_SETUP.md"
        pause
        return
    fi
    
    # Проверка валидности
    if ! jq . "$CONFIG_DIR/sa-key.json" >/dev/null 2>&1; then
        error "❌ SA ключ НЕВАЛИДЕН!"
        echo
        warn "Файл существует но содержит ошибки."
        warn "Загрузи ключ заново."
        pause
        return
    fi
    
    success "✅ SA ключ найден и валиден"
    echo
    
    # Информация о ключе
    info "📋 Информация о Service Account:"
    echo
    
    sa_id=$(cat "$CONFIG_DIR/sa-key.json" | jq -r '.service_account_id')
    key_id=$(cat "$CONFIG_DIR/sa-key.json" | jq -r '.id')
    
    echo "  Service Account ID:"
    echo "    $sa_id"
    echo
    echo "  Key ID:"
    echo "    $key_id"
    echo
    
    # Проверка прав
    perms=$(stat -c "%a" "$CONFIG_DIR/sa-key.json")
    if [[ "$perms" != "600" ]]; then
        warn "⚠️  Права на файл: $perms (должно быть 600)"
        echo
        info "Исправляю права..."
        chmod 600 "$CONFIG_DIR/sa-key.json"
        success "Права исправлены!"
        echo
    else
        success "Права на файл: OK (600)"
    fi
    
    # Проверка в логах
    echo
    info "📜 Последние упоминания SA в логах:"
    echo
    docker logs vps-watchdog 2>&1 | grep -i "service.*account\|authorized\|iam" | tail -5 || echo "  Логи пока пусты"
    
    echo
    success "Проверка завершена!"
    
    pause
}

