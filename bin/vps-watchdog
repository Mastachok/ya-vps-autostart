#!/usr/bin/env bash

APP_DIR="/opt/vps-watchdog"
PROFILES_DIR="$APP_DIR/profiles"
ACTIVE_PROFILE="$(cat $APP_DIR/ACTIVE_PROFILE 2>/dev/null || echo default)"

color_ok="\e[32m✔\e[0m"
color_bad="\e[31m✘\e[0m"

has_key() {
  [[ -f "$PROFILES_DIR/$ACTIVE_PROFILE.sa-key.json" ]] && echo "$color_ok" || echo "$color_bad"
}

container_status() {
  docker ps --format '{{.Names}}' | grep -q vps-watchdog && echo "$color_ok" || echo "$color_bad"
}

while true; do
  clear
  echo -e "СТАТУС:"
  echo -e "Активный профиль: $ACTIVE_PROFILE"
  echo -e "Service Account: $(has_key)"
  echo -e "Контейнер: $(container_status)"
  echo
  echo "МЕНЮ:"
  echo "1. Профили"
  echo "2. Переключить профиль"
  echo "3. Создать Service Account + Key"
  echo "4. Логи"
  echo "5. Статус"
  echo "6. Тест пинга"
  echo "0. Выход"
  echo
  read -rp "> " choice

  case "$choice" in
    1) ls -1 "$PROFILES_DIR"; read -rp "Enter..." ;;
    2) nano "$APP_DIR/ACTIVE_PROFILE" ;;
    3) echo "TODO: yc create sa"; read -rp "Enter..." ;;
    4) docker logs -f vps-watchdog ;;
    5) systemctl status vps-watchdog --no-pager; read -rp "Enter..." ;;
    6) ping -c 3 1.1.1.1; read -rp "Enter..." ;;
    0) exit 0 ;;
  esac
done
