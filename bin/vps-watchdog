#!/usr/bin/env bash
set -euo pipefail

# ═══════════════════════════════════════════════════════════════════
# VPS Watchdog v2.0 - Управление
# ═══════════════════════════════════════════════════════════════════

APP_DIR="/opt/vps-watchdog"
CONFIG_FILE="$APP_DIR/config/watchdog.env"
KEY_FILE="$APP_DIR/config/sa-key.json"
SERVICE="vps-watchdog.service"

# Цвета
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m'

# Функции вывода
info() { echo -e "${CYAN}ℹ️  $*${NC}"; }
success() { echo -e "${GREEN}✅ $*${NC}"; }
error() { echo -e "${RED}❌ $*${NC}"; }
warn() { echo -e "${YELLOW}⚠️  $*${NC}"; }
title() { echo -e "${BOLD}${BLUE}$*${NC}"; }
hr() { echo -e "${GRAY}════════════════════════════════════════════════════════════${NC}"; }

# Проверка root
need_root() {
    if [[ $EUID -ne 0 ]]; then
        error "Запусти с sudo: sudo vps-watchdog"
        exit 1
    fi
}

# Пауза
pause() {
    echo
    read -r -p "Нажми Enter для продолжения..." _
}

# ═══════════════════════════════════════════════════════════════════
# ЗАГРУЗКА КОНФИГУРАЦИИ
# ═══════════════════════════════════════════════════════════════════

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$CONFIG_FILE" 2>/dev/null || true
    fi
}

# ═══════════════════════════════════════════════════════════════════
# ПРОВЕРКА СТАТУСОВ
# ═══════════════════════════════════════════════════════════════════

check_service_status() {
    if systemctl is-active --quiet "$SERVICE"; then
        echo -e "${GREEN}работает${NC}"
    else
        echo -e "${RED}остановлен${NC}"
    fi
}

check_container_status() {
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "vps-watchdog"; then
        echo -e "${GREEN}работает${NC}"
    else
        echo -e "${RED}остановлен${NC}"
    fi
}

check_config_status() {
    if [[ -f "$CONFIG_FILE" ]] && [[ -s "$CONFIG_FILE" ]]; then
        load_config
        if [[ -n "${VM_HOST:-}" ]] && [[ -n "${INSTANCE_ID:-}" ]]; then
            echo -e "${GREEN}настроен${NC}"
        else
            echo -e "${YELLOW}не заполнен${NC}"
        fi
    else
        echo -e "${RED}отсутствует${NC}"
    fi
}

check_key_status() {
    if [[ -f "$KEY_FILE" ]] && [[ -s "$KEY_FILE" ]]; then
        if jq empty "$KEY_FILE" >/dev/null 2>&1; then
            echo -e "${GREEN}есть${NC}"
        else
            echo -e "${YELLOW}невалидный${NC}"
        fi
    else
        echo -e "${RED}нет${NC}"
    fi
}

check_ping_status() {
    load_config
    if [[ -z "${VM_HOST:-}" ]]; then
        echo -e "${GRAY}не настроено${NC}"
        return
    fi
    
    if timeout 3 ping -c 1 -W 1 "${VM_HOST}" >/dev/null 2>&1; then
        echo -e "${GREEN}отвечает${NC}"
    else
        echo -e "${RED}не отвечает${NC}"
    fi
}

# ═══════════════════════════════════════════════════════════════════
# ГЛАВНОЕ МЕНЮ
# ═══════════════════════════════════════════════════════════════════

main_menu() {
    while true; do
        clear
        load_config
        
        title "═══════════════════════════════════════════════════════════════"
        title "        🛡️  VPS WATCHDOG - Автозапуск VM в Yandex Cloud        "
        title "═══════════════════════════════════════════════════════════════"
        echo
        
        info "📊 СТАТУС:"
        echo -e "   🌐 VM Host:      ${VM_HOST:-${GRAY}не указан${NC}}"
        echo -e "   🆔 Instance ID:  ${INSTANCE_ID:-${GRAY}не указан${NC}}"
        echo -e "   📝 Конфигурация: $(check_config_status)"
        echo -e "   🔑 Ключ SA:      $(check_key_status)"
        echo -e "   ⚙️  Сервис:       $(check_service_status)"
        echo -e "   🐳 Контейнер:    $(check_container_status)"
        echo -e "   📡 Ping VM:      $(check_ping_status)"
        
        hr
        echo
        echo "  1) 🚀 Быстрая настройка (для новичков)"
        echo "  2) ⚙️  Настроить конфигурацию"
        echo "  3) 🔑 Настроить ключ Service Account"
        echo "  4) 🔧 Управление сервисом"
        echo "  5) 📜 Показать логи"
        echo "  6) 📡 Проверить ping"
        echo "  7) ℹ️  Помощь"
        echo "  8) 🔍 Получить данные VM (OAuth)" 
        echo "  0) 🚪 Выход"
        echo
        
        read -r -p "Выбери пункт: " choice
        
        case $choice in
            1) quick_setup ;;
            2) config_menu ;;
            3) setup_key ;;
            4) service_menu ;;
            5) show_logs ;;
            6) test_ping ;;
            7) show_help ;;
            8) get_vm_data_oauth ;;
            0) exit 0 ;;
            *) warn "Неверный выбор"; pause ;;
        esac
    done
}

# ═══════════════════════════════════════════════════════════════════
# БЫСТРАЯ НАСТРОЙКА
# ═══════════════════════════════════════════════════════════════════

quick_setup() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "           🚀 БЫСТРАЯ НАСТРОЙКА (для новичков)               "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    info "Этот мастер проведёт тебя через все шаги настройки."
    info "Тебе понадобится:"
    echo "  • VM_HOST - внешний IP твоей VM"
    echo "  • INSTANCE_ID - ID VM в Yandex Cloud"
    echo "  • yc CLI установленный и настроенный"
    echo
    pause
    
    # Шаг 1: Проверка yc
    clear
    title "Шаг 1/4: Проверка Yandex Cloud CLI"
    hr
    echo
    
    if ! command -v yc >/dev/null 2>&1; then
        warn "yc CLI не установлен"
        echo
        echo "Установи командой:"
        echo "  curl -fsSL https://storage.yandexcloud.net/yandexcloud-yc/install.sh | bash"
        echo "  source ~/.bashrc"
        pause
        return
    fi
    
    success "yc CLI установлен"
    
    if ! yc config list >/dev/null 2>&1; then
        warn "yc CLI не настроен"
        echo
        info "Запускаю yc init..."
        pause
        yc init || true
    fi
    
    if yc config list >/dev/null 2>&1; then
        success "yc CLI настроен"
    else
        error "yc CLI всё ещё не настроен"
        pause
        return
    fi
    
    pause
    
    # Шаг 2: Конфигурация
    clear
    title "Шаг 2/4: Настройка конфигурации"
    hr
    echo
    
    info "Получить INSTANCE_ID:"
    echo "  yc compute instance list"
    echo
    
    read -r -p "Введи VM_HOST (внешний IP VM): " vm_host
    read -r -p "Введи INSTANCE_ID (UUID VM): " instance_id
    
    if [[ -z "$vm_host" ]] || [[ -z "$instance_id" ]]; then
        error "VM_HOST и INSTANCE_ID обязательны"
        pause
        return
    fi
    
    # Создаём конфиг
    cat > "$CONFIG_FILE" <<EOF
# VPS Watchdog Configuration
VM_HOST=$vm_host
INSTANCE_ID=$instance_id
SA_KEY_FILE=/app/config/sa-key.json

CHECK_INTERVAL=60
PING_COUNT=3
PING_TIMEOUT=5
COOLDOWN_MINUTES=5
MAX_START_ATTEMPTS=3
EOF
    
    success "Конфигурация сохранена"
    pause
    
    # Шаг 3: Service Account
    clear
    title "Шаг 3/4: Создание Service Account и ключа"
    hr
    echo
    
    info "Сейчас создам Service Account для управления VM"
    echo
    
    read -r -p "Folder ID (из yc config list): " folder_id
    
    if [[ -z "$folder_id" ]]; then
        error "Folder ID обязателен"
        pause
        return
    fi
    
    sa_name="watchdog-$(date +%s)"
    
    info "Создаю Service Account: $sa_name"
    sa_id=$(yc iam service-account create --name "$sa_name" --folder-id "$folder_id" --format json | jq -r '.id') || {
        error "Не удалось создать Service Account"
        pause
        return
    }
    
    success "Service Account создан: $sa_id"
    
    info "Выдаю права compute.operator..."
    yc resource-manager folder add-access-binding "$folder_id" \
        --role compute.operator \
        --subject "serviceAccount:$sa_id" >/dev/null || {
        error "Не удалось выдать права"
        pause
        return
    }
    
    success "Права выданы"
    
    info "Создаю ключ..."
    yc iam key create --service-account-id "$sa_id" --output "$KEY_FILE" >/dev/null || {
        error "Не удалось создать ключ"
        pause
        return
    }
    chmod 600 "$KEY_FILE"
    
    success "Ключ создан и сохранён"
    pause
    
    # Шаг 4: Запуск
    clear
    title "Шаг 4/4: Запуск watchdog"
    hr
    echo
    
    info "Перезапускаю сервис..."
    systemctl restart "$SERVICE" || {
        error "Не удалось перезапустить сервис"
        pause
        return
    }
    
    success "Сервис запущен!"
    echo
    info "Проверяю логи..."
    sleep 3
    
    docker logs --tail=20 vps-watchdog || true
    
    echo
    success "✅ Настройка завершена!"
    info "Watchdog теперь следит за твоей VM"
    pause
}

# ═══════════════════════════════════════════════════════════════════
# НАСТРОЙКА КОНФИГУРАЦИИ
# ═══════════════════════════════════════════════════════════════════

config_menu() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                  ⚙️  НАСТРОЙКА КОНФИГУРАЦИИ                   "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    echo "Выбери действие:"
    echo "  1) 📝 Редактировать конфигурацию (nano)"
    echo "  2) 👀 Показать текущую конфигурацию"
    echo "  3) 🔄 Создать новую конфигурацию"
    echo "  0) ↩️  Назад"
    echo
    
    read -r -p "Выбери: " choice
    
    case $choice in
        1)
            if [[ ! -f "$CONFIG_FILE" ]]; then
                warn "Конфиг не существует, создаю..."
                mkdir -p "$(dirname "$CONFIG_FILE")"
                cp "$APP_DIR/config/watchdog.env.example" "$CONFIG_FILE" 2>/dev/null || {
                    cat > "$CONFIG_FILE" <<'EOF'
VM_HOST=
INSTANCE_ID=
SA_KEY_FILE=/app/config/sa-key.json
CHECK_INTERVAL=60
PING_COUNT=3
PING_TIMEOUT=5
COOLDOWN_MINUTES=5
MAX_START_ATTEMPTS=3
EOF
                }
            fi
            
            info "Открываю редактор..."
            info "Подсказка: Ctrl+O → Enter → Ctrl+X для сохранения"
            pause
            nano "$CONFIG_FILE"
            
            info "Перезапускаю сервис..."
            systemctl restart "$SERVICE"
            success "Конфигурация обновлена"
            pause
            ;;
        2)
            echo
            if [[ -f "$CONFIG_FILE" ]]; then
                info "Текущая конфигурация:"
                cat "$CONFIG_FILE"
            else
                warn "Конфигурация не найдена"
            fi
            pause
            ;;
        3)
            warn "Это перезапишет текущую конфигурацию!"
            read -r -p "Продолжить? (yes/no): " confirm
            if [[ "$confirm" == "yes" ]]; then
                read -r -p "VM_HOST: " vm_host
                read -r -p "INSTANCE_ID: " instance_id
                
                cat > "$CONFIG_FILE" <<EOF
VM_HOST=$vm_host
INSTANCE_ID=$instance_id
SA_KEY_FILE=/app/config/sa-key.json
CHECK_INTERVAL=60
PING_COUNT=3
PING_TIMEOUT=5
COOLDOWN_MINUTES=5
MAX_START_ATTEMPTS=3
EOF
                success "Новая конфигурация создана"
                systemctl restart "$SERVICE"
            fi
            pause
            ;;
        0) return ;;
    esac
}

# ═══════════════════════════════════════════════════════════════════
# НАСТРОЙКА КЛЮЧА
# ═══════════════════════════════════════════════════════════════════

setup_key() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "              🔑 НАСТРОЙКА SERVICE ACCOUNT КЛЮЧА                "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -f "$CONFIG_FILE" ]]; then
        error "Сначала настрой конфигурацию (пункт 2)"
        pause
        return
    fi
    
    if ! command -v yc >/dev/null 2>&1; then
        error "yc CLI не установлен"
        pause
        return
    fi
    
    info "Создание Service Account и ключа"
    echo
    
    read -r -p "Folder ID (из yc config list): " folder_id
    if [[ -z "$folder_id" ]]; then
        error "Folder ID обязателен"
        pause
        return
    fi
    
    read -r -p "Имя Service Account [watchdog]: " sa_name
    sa_name=${sa_name:-watchdog}
    
    info "Создаю Service Account..."
    sa_id=$(yc iam service-account create --name "$sa_name" --folder-id "$folder_id" --format json 2>/dev/null | jq -r '.id') || {
        error "Ошибка создания SA"
        echo "Возможно SA с таким именем уже существует"
        echo "Попробуй другое имя или используй существующий"
        pause
        return
    }
    
    success "Service Account создан: $sa_id"
    
    info "Выдаю права..."
    yc resource-manager folder add-access-binding "$folder_id" \
        --role compute.operator \
        --subject "serviceAccount:$sa_id" >/dev/null
    
    info "Создаю ключ..."
    mkdir -p "$(dirname "$KEY_FILE")"
    yc iam key create --service-account-id "$sa_id" --output "$KEY_FILE" >/dev/null
    chmod 600 "$KEY_FILE"
    
    success "Ключ создан: $KEY_FILE"
    
    info "Перезапускаю сервис..."
    systemctl restart "$SERVICE"
    
    success "Готово!"
    pause
}

# ═══════════════════════════════════════════════════════════════════
# УПРАВЛЕНИЕ СЕРВИСОМ
# ═══════════════════════════════════════════════════════════════════

service_menu() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                   🔧 УПРАВЛЕНИЕ СЕРВИСОМ                      "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    echo "  1) ▶️  Запустить"
    echo "  2) ⏹  Остановить"
    echo "  3) 🔄 Перезапустить"
    echo "  4) 📊 Статус"
    echo "  0) ↩️  Назад"
    echo
    
    read -r -p "Выбери: " choice
    
    case $choice in
        1) systemctl start "$SERVICE" && success "Запущен" || error "Ошибка"; pause ;;
        2) systemctl stop "$SERVICE" && success "Остановлен" || error "Ошибка"; pause ;;
        3) systemctl restart "$SERVICE" && success "Перезапущен" || error "Ошибка"; pause ;;
        4) systemctl status "$SERVICE" --no-pager; pause ;;
        0) return ;;
    esac
}

# ═══════════════════════════════════════════════════════════════════
# ЛОГИ
# ═══════════════════════════════════════════════════════════════════

show_logs() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                       📜 ЛОГИ WATCHDOG                         "
    title "═══════════════════════════════════════════════════════════════"
    echo
    info "Показываю логи (Ctrl+C для выхода)"
    hr
    docker logs -f --tail=100 vps-watchdog 2>/dev/null || {
        error "Контейнер не запущен"
        pause
    }
}

# ═══════════════════════════════════════════════════════════════════
# ПРОВЕРКА PING
# ═══════════════════════════════════════════════════════════════════

test_ping() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                     📡 ПРОВЕРКА PING                          "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    load_config
    
    if [[ -z "${VM_HOST:-}" ]]; then
        warn "VM_HOST не настроен"
        pause
        return
    fi
    
    info "Пингую $VM_HOST..."
    hr
    ping -c 5 -W 2 "$VM_HOST" || warn "VM не отвечает"
    hr
    pause
}

# ═══════════════════════════════════════════════════════════════════
# ПОЛУЧЕНИЕ ДАННЫХ VM ЧЕРЕЗ OAUTH
# ═══════════════════════════════════════════════════════════════════

get_vm_data_oauth() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "           🔍 ПОЛУЧЕНИЕ ДАННЫХ VM (OAuth)                    "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    # Проверка зависимостей
    if ! command -v jq >/dev/null 2>&1; then
        warn "jq не установлен, пытаюсь установить..."
        apt-get update -qq && apt-get install -y -qq jq || {
            error "Не удалось установить jq"
            pause
            return
        }
    fi
    
    # OAuth авторизация
    info "🌐 АВТОРИЗАЦИЯ ЧЕРЕЗ БРАУЗЕР"
    hr
    echo
    echo "1️⃣  Открой эту ссылку в браузере:"
    echo
    echo -e "${GREEN}${BOLD}https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb${NC}"
    echo
    echo "2️⃣  Авторизуйся в Yandex"
    echo "3️⃣  Разреши доступ к Yandex Cloud"
    echo "4️⃣  Скопируй токен"
    echo
    echo -e "${YELLOW}⚠️  Токен выглядит так: y0_AgAAAABabcdef...${NC}"
    echo
    
    read -r -p "Вставь токен: " oauth_token
    
    if [[ -z "$oauth_token" ]]; then
        error "Токен пустой"
        pause
        return
    fi
    
    echo
    success "OAuth токен получен"
    
    # Получаем IAM токен из OAuth токена
    info "🔄 Получаю IAM токен..."
    
    iam_response=$(curl -s -X POST \
        -H "Content-Type: application/json" \
        -d "{\"yandexPassportOauthToken\": \"$oauth_token\"}" \
        "https://iam.api.cloud.yandex.net/iam/v1/tokens")
    
    iam_token=$(echo "$iam_response" | jq -r '.iamToken // empty')
    
    if [[ -z "$iam_token" ]]; then
        error "Не удалось получить IAM токен"
        echo "Ответ API:"
        echo "$iam_response" | jq .
        pause
        return
    fi
    
    success "IAM токен получен"
    
    # Функция для API запросов
    yc_api() {
        curl -s -X "$1" \
            -H "Authorization: Bearer $iam_token" \
            -H "Content-Type: application/json" \
            "$2"
    }
    
    # Получаем список облаков
    echo
    info "☁️  Получаю список облаков..."
    
    clouds=$(yc_api GET "https://resource-manager.api.cloud.yandex.net/resource-manager/v1/clouds")
    cloud_count=$(echo "$clouds" | jq '.clouds // [] | length')
    
    if [[ "$cloud_count" -eq 0 ]]; then
        error "Облака не найдены"
        warn "У аккаунта нет доступа к Yandex Cloud"
        echo
        echo "Ответ API:"
        echo "$clouds" | jq .
        echo
        warn "Решение:"
        echo "  1. Убедись что у аккаунта есть доступ к Yandex Cloud"
        echo "  2. Проверь что аккаунт добавлен в организацию"
        echo "  3. Выдай роль 'viewer' или 'admin'"
        pause
        return
    fi
    
    success "Найдено облаков: $cloud_count"
    
    # Если облако одно - выбираем автоматически
    if [[ "$cloud_count" -eq 1 ]]; then
        cloud_id=$(echo "$clouds" | jq -r '.clouds[0].id')
        cloud_name=$(echo "$clouds" | jq -r '.clouds[0].name')
        success "Выбрано облако: $cloud_name ($cloud_id)"
    else
        # Показываем список облаков
        echo
        echo "┌────────────────────────────────────────────────────────────┐"
        echo "│                    ДОСТУПНЫЕ ОБЛАКА                         │"
        echo "└────────────────────────────────────────────────────────────┘"
        echo
        
        i=1
        declare -A cloud_map
        while IFS= read -r cloud; do
            name=$(echo "$cloud" | jq -r '.name')
            id=$(echo "$cloud" | jq -r '.id')
            
            cloud_map[$i]="$id"
            
            echo -e "${BOLD}$i)${NC} ${CYAN}$name${NC}"
            echo "   ID: $id"
            echo
            
            ((i++))
        done < <(echo "$clouds" | jq -c '.clouds[]')
        
        read -r -p "Выбери номер облака: " cloud_choice
        
        if [[ ! "$cloud_choice" =~ ^[0-9]+$ ]] || [[ -z "${cloud_map[$cloud_choice]:-}" ]]; then
            error "Неверный выбор"
            pause
            return
        fi
        
        cloud_id="${cloud_map[$cloud_choice]}"
    fi
    
    # Получаем список папок в облаке
    echo
    info "📁 Получаю список папок..."
    
    folders=$(yc_api GET "https://resource-manager.api.cloud.yandex.net/resource-manager/v1/folders?cloudId=$cloud_id")
    folder_count=$(echo "$folders" | jq '.folders // [] | length')
    
    if [[ "$folder_count" -eq 0 ]]; then
        error "Папки не найдены"
        warn "Возможно у токена нет прав"
        echo
        echo "Ответ API:"
        echo "$folders" | jq .
        echo
        warn "Попробуй получить список облаков (clouds):"
        clouds=$(yc_api GET "https://resource-manager.api.cloud.yandex.net/resource-manager/v1/clouds")
        echo "$clouds" | jq .
        pause
        return
    fi
    
    success "Найдено папок: $folder_count"
    echo
    
    # Показываем папки
    echo "┌────────────────────────────────────────────────────────────┐"
    echo "│                    ДОСТУПНЫЕ ПАПКИ                          │"
    echo "└────────────────────────────────────────────────────────────┘"
    echo
    
    i=1
    declare -A folder_map
    while IFS= read -r folder; do
        name=$(echo "$folder" | jq -r '.name')
        id=$(echo "$folder" | jq -r '.id')
        
        folder_map[$i]="$id"
        
        echo -e "${BOLD}$i)${NC} ${CYAN}$name${NC}"
        echo "   ID: $id"
        echo
        
        ((i++))
    done < <(echo "$folders" | jq -c '.folders[]')
    
    read -r -p "Выбери номер папки: " folder_choice
    
    if [[ ! "$folder_choice" =~ ^[0-9]+$ ]] || [[ -z "${folder_map[$folder_choice]:-}" ]]; then
        error "Неверный выбор"
        pause
        return
    fi
    
    folder_id="${folder_map[$folder_choice]}"
    success "Выбрана папка: $folder_id"
    
    # Получаем список VM
    echo
    info "🖥️  Получаю список VM..."
    
    vms=$(yc_api GET "https://compute.api.cloud.yandex.net/compute/v1/instances?folderId=$folder_id")
    vm_count=$(echo "$vms" | jq '.instances // [] | length')
    
    if [[ "$vm_count" -eq 0 ]]; then
        warn "VM не найдены в этой папке"
        pause
        return
    fi
    
    success "Найдено VM: $vm_count"
    echo
    
    # Показываем VM
    echo "┌────────────────────────────────────────────────────────────┐"
    echo "│                 ДОСТУПНЫЕ ВИРТУАЛЬНЫЕ МАШИНЫ                │"
    echo "└────────────────────────────────────────────────────────────┘"
    echo
    
    i=1
    declare -A vm_map
    while IFS= read -r vm; do
        name=$(echo "$vm" | jq -r '.name')
        id=$(echo "$vm" | jq -r '.id')
        status=$(echo "$vm" | jq -r '.status')
        ip=$(echo "$vm" | jq -r '.networkInterfaces[0].primaryV4Address.oneToOneNat.address // "нет IP"')
        
        vm_map[$i]="$id|$ip"
        
        echo -e "${BOLD}$i)${NC} ${CYAN}$name${NC}"
        echo "   ID:     $id"
        echo "   IP:     $ip"
        echo "   Статус: $status"
        echo
        
        ((i++))
    done < <(echo "$vms" | jq -c '.instances[]')
    
    read -r -p "Выбери номер VM для мониторинга: " vm_choice
    
    if [[ ! "$vm_choice" =~ ^[0-9]+$ ]] || [[ -z "${vm_map[$vm_choice]:-}" ]]; then
        error "Неверный выбор"
        pause
        return
    fi
    
    IFS='|' read -r instance_id vm_host <<< "${vm_map[$vm_choice]}"
    
    echo
    success "Выбрана VM:"
    echo "   Instance ID: $instance_id"
    echo "   VM Host:     $vm_host"
    echo
    
    # Обновляем конфиг
    info "Обновляю конфигурацию..."
    
    sed -i "s|^VM_HOST=.*|VM_HOST=$vm_host|" "$CONFIG_FILE"
    sed -i "s|^INSTANCE_ID=.*|INSTANCE_ID=$instance_id|" "$CONFIG_FILE"
    
    success "Конфигурация обновлена!"
    echo
    warn "⚠️  Теперь создай Service Account через веб-консоль:"
    echo "   https://console.cloud.yandex.ru → IAM → Service accounts"
    echo
    echo "   1) Создай SA: watchdog"
    echo "   2) Роль: compute.operator"
    echo "   3) Создай ключ"
    echo "   4) Скачай и скопируй:"
    echo "      scp key.json root@$(hostname -I | awk '{print $1}'):/opt/vps-watchdog/config/sa-key.json"
    echo
    
    pause
}

# ═══════════════════════════════════════════════════════════════════
# ПОМОЩЬ
# ═══════════════════════════════════════════════════════════════════

show_help() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                         ℹ️  ПОМОЩЬ                             "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    info "🚀 Быстрый старт:"
    echo "  1. Запусти 'Быструю настройку' (пункт 1)"
    echo "  2. Следуй инструкциям мастера"
    echo "  3. Watchdog автоматически запустится"
    echo
    
    info "📝 Что настроить:"
    echo "  • VM_HOST - внешний IP твоей VM"
    echo "  • INSTANCE_ID - ID VM (yc compute instance list)"
    echo "  • Service Account ключ - для управления VM"
    echo
    
    info "❓ Частые вопросы:"
    echo "  Q: VM не запускается?"
    echo "  A: Проверь логи (пункт 5) и права SA"
    echo
    echo "  Q: Где взять INSTANCE_ID?"
    echo "  A: Команда: yc compute instance list"
    echo
    echo "  Q: Как часто проверяется VM?"
    echo "  A: По умолчанию каждые 60 секунд"
    echo
    
    info "🔗 Документация:"
    echo "  GitHub: https://github.com/Mastachok/ya-vps-autostart"
    echo
    
    pause
}

