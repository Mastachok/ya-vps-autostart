#!/usr/bin/env bash
set -euo pipefail

# ═══════════════════════════════════════════════════════════════════
# VPS WATCHDOG v3.0 - Интерактивное меню
# ═══════════════════════════════════════════════════════════════════

VERSION="3.0.1"
CONFIG_DIR="/opt/vps-watchdog/config"
PROFILES_DIR="/opt/vps-watchdog/profiles"
DATA_DIR="/opt/vps-watchdog/data"
KEY_FILE="$CONFIG_DIR/sa-key.json"
TELEGRAM_CONFIG="$CONFIG_DIR/telegram.json"
SERVICE="vps-watchdog"

# Цвета
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
GRAY='\033[0;90m'
NC='\033[0m'

# ═══════════════════════════════════════════════════════════════════
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ═══════════════════════════════════════════════════════════════════

title() {
    echo -e "${CYAN}${BOLD}$1${NC}"
}

success() {
    echo -e "${GREEN}✅ $1${NC}"
}

error() {
    echo -e "${RED}❌ $1${NC}"
}

warn() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

hr() {
    echo -e "${GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

pause() {
    echo
    read -r -p "Нажми Enter для продолжения..."
}

count_profiles() {
    # Создаём директорию если не существует
    mkdir -p "$PROFILES_DIR" 2>/dev/null || true
    
    if [[ ! -d "$PROFILES_DIR" ]]; then
        echo "0 0"
        return
    fi
    
    local total=$(find "$PROFILES_DIR" -maxdepth 1 -name "*.json" -type f 2>/dev/null | wc -l)
    local enabled=0
    
    # Проверяем наличие jq перед использованием
    if ! command -v jq >/dev/null 2>&1; then
        echo "$total ?"
        return
    fi
    
    shopt -s nullglob
    for file in "$PROFILES_DIR"/*.json; do
        [[ -f "$file" ]] || continue
        if jq -e '.enabled == true' "$file" >/dev/null 2>&1; then
            ((enabled++)) || true
        fi
    done
    shopt -u nullglob
    echo "$total $enabled"
}

get_service_status() {
    if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
        echo -e "${GREEN}работает${NC}"
    else
        echo -e "${RED}остановлен${NC}"
    fi
}

get_telegram_status() {
    if [[ -f "$TELEGRAM_CONFIG" ]]; then
        if jq -e '.enabled == true' "$TELEGRAM_CONFIG" >/dev/null 2>&1; then
            echo -e "${GREEN}подключен${NC}"
        else
            echo -e "${YELLOW}отключен${NC}"
        fi
    else
        echo -e "${GRAY}не настроен${NC}"
    fi
}

# ═══════════════════════════════════════════════════════════════════
# ГЛАВНОЕ МЕНЮ
# ═══════════════════════════════════════════════════════════════════

main_menu() {
    while true; do
        clear
        # ИСПРАВЛЕНО: Безопасное чтение профилей без process substitution
        local profile_info
        profile_info=$(count_profiles)
        local total=$(echo "$profile_info" | cut -d' ' -f1)
        local enabled=$(echo "$profile_info" | cut -d' ' -f2)
        
        title "═══════════════════════════════════════════════════════════════"
        title "           🛡️  VPS WATCHDOG v${VERSION}                        "
        title "═══════════════════════════════════════════════════════════════"
        echo
        
        info "📊 СТАТУС:"
        echo -e "   📝 Профилей: ${BOLD}$total${NC} (активных: ${GREEN}$enabled${NC})"
        echo -e "   ⚙️  Сервис: $(get_service_status)"
        echo -e "   📱 Telegram: $(get_telegram_status)"
        
        hr
        echo
        echo -e "${BOLD}📋 УПРАВЛЕНИЕ ПРОФИЛЯМИ:${NC}"
        echo "  1) 📝 Список профилей"
        echo "  2) ➕ Добавить профиль (OAuth)"
        echo "  3) ✏️  Редактировать профиль"
        echo "  4) 🗑️  Удалить профиль"
        echo "  5) 🔄 Включить/выключить мониторинг"
        echo
        echo -e "${BOLD}📱 TELEGRAM:${NC}"
        echo "  6) 🤖 Настроить бота"
        echo "  7) 📤 Тест уведомления"
        echo "  8) 📊 Статус бота"
        echo
        echo -e "${BOLD}🔐 OAUTH:${NC}"
        echo "  12) 🔑 Управление OAuth токеном"
        echo
        echo -e "${BOLD}⚙️  СИСТЕМА:${NC}"
        echo "  9) 🔧 Управление сервисом"
        echo "  10) 📜 Показать логи"
        echo "  11) 📈 Статистика"
        echo
        echo -e "${BOLD}ℹ️  ИНФОРМАЦИЯ:${NC}"
        echo "  0) ❓ Помощь"
        echo "  q) 🚪 Выход"
        echo
        
        read -r -p "Выбери пункт: " choice
        
        case $choice in
            1) list_profiles ;;
            2) add_profile_oauth ;;
            3) edit_profile ;;
            4) delete_profile ;;
            5) toggle_profile ;;
            6) setup_telegram ;;
            7) test_telegram ;;
            8) telegram_status ;;
            9) service_menu ;;
            10) show_logs ;;
            11) show_stats ;;
            12) manage_oauth ;;
            0) show_help ;;
            q|Q) exit 0 ;;
            *) warn "Неверный выбор"; pause ;;
        esac
    done
}

# ═══════════════════════════════════════════════════════════════════
# УПРАВЛЕНИЕ ПРОФИЛЯМИ
# ═══════════════════════════════════════════════════════════════════

list_profiles() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                     📝 СПИСОК ПРОФИЛЕЙ                        "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -d "$PROFILES_DIR" ]] || [[ -z "$(ls -A "$PROFILES_DIR"/*.json 2>/dev/null)" ]]; then
        warn "Нет профилей"
        echo
        info "Добавь профиль через пункт 2 (Добавить профиль)"
        pause
        return
    fi
    
    echo "┌────────────────────────────────────────────────────────────────┐"
    echo "│                         ПРОФИЛИ VM                              │"
    echo "└────────────────────────────────────────────────────────────────┘"
    echo
    
    local i=1
    for file in "$PROFILES_DIR"/*.json; do
        [[ -f "$file" ]] || continue
        
        local name=$(jq -r '.name' "$file")
        local vm_host=$(jq -r '.vm_host' "$file")
        local instance_id=$(jq -r '.instance_id' "$file")
        local enabled=$(jq -r '.enabled' "$file")
        local check_interval=$(jq -r '.check_interval' "$file")
        
        local status_icon="🔴"
        local status_text="выключен"
        if [[ "$enabled" == "true" ]]; then
            status_icon="🟢"
            status_text="${GREEN}включен${NC}"
        fi
        
        echo -e "${BOLD}$i) $status_icon $name${NC}"
        echo "   IP:       $vm_host"
        echo "   ID:       ${instance_id:0:20}..."
        echo -e "   Статус:   $status_text"
        echo "   Интервал: ${check_interval}с"
        echo
        
        ((i++))
    done
    
    hr
    pause
}

add_profile_oauth() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                ➕ ДОБАВИТЬ ПРОФИЛЬ (OAuth)                    "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    # Проверка jq
    if ! command -v jq >/dev/null 2>&1; then
        warn "jq не установлен, устанавливаю..."
        apt-get update -qq && apt-get install -y -qq jq || {
            error "Не удалось установить jq"
            pause
            return
        }
    fi
    
    # Проверяем наличие сохранённого OAuth токена
    oauth_token=""
    if [[ -f "$CONFIG_DIR/oauth-token.txt" ]]; then
        oauth_token=$(cat "$CONFIG_DIR/oauth-token.txt" 2>/dev/null | tr -d '\n\r ')
        if [[ -n "$oauth_token" ]]; then
            success "Найден сохранённый OAuth токен"
            echo
            read -r -p "Использовать сохранённый токен? (y/n): " use_saved
            if [[ "$use_saved" =~ ^[Yy]$ ]]; then
                info "Использую сохранённый OAuth токен"
            else
                oauth_token=""
            fi
        fi
    fi
    
    # Если токена нет - запрашиваем новый
    if [[ -z "$oauth_token" ]]; then
        # OAuth авторизация
        info "🌐 АВТОРИЗАЦИЯ ЧЕРЕЗ БРАУЗЕР"
        hr
        echo
        echo "1️⃣  Открой эту ссылку в браузере:"
        echo
        echo -e "${GREEN}${BOLD}https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb${NC}"
        echo
        echo "2️⃣  Авторизуйся в Yandex"
        echo "3️⃣  Разреши доступ к Yandex Cloud"
        echo "4️⃣  Скопируй токен"
        echo
        
        read -r -p "Вставь OAuth токен: " oauth_token
        
        if [[ -z "$oauth_token" ]]; then
            error "Токен пустой"
            pause
            return
        fi
        
        success "OAuth токен получен"
        
        # Сохраняем OAuth токен для будущего использования
        info "💾 Сохраняю OAuth токен..."
        mkdir -p "$CONFIG_DIR"
        echo "$oauth_token" > "$CONFIG_DIR/oauth-token.txt"
        chmod 600 "$CONFIG_DIR/oauth-token.txt"
        success "OAuth токен сохранён в $CONFIG_DIR/oauth-token.txt"
    fi
    
    # Получаем IAM токен
    info "🔄 Получаю IAM токен..."
    
    iam_response=$(curl -s -X POST \
        -H "Content-Type: application/json" \
        -d "{\"yandexPassportOauthToken\": \"$oauth_token\"}" \
        "https://iam.api.cloud.yandex.net/iam/v1/tokens")
    
    iam_token=$(echo "$iam_response" | jq -r '.iamToken // empty')
    
    if [[ -z "$iam_token" ]]; then
        error "Не удалось получить IAM токен"
        pause
        return
    fi
    
    success "IAM токен получен"
    
    # Функция для API запросов
    yc_api() {
        curl -s -X "$1" \
            -H "Authorization: Bearer $iam_token" \
            -H "Content-Type: application/json" \
            "$2"
    }
    
    # Получаем облака
    echo
    info "☁️  Получаю список облаков..."
    
    clouds=$(yc_api GET "https://resource-manager.api.cloud.yandex.net/resource-manager/v1/clouds")
    cloud_count=$(echo "$clouds" | jq '.clouds // [] | length')
    
    if [[ "$cloud_count" -eq 0 ]]; then
        error "Облака не найдены"
        pause
        return
    fi
    
    success "Найдено облаков: $cloud_count"
    
    # Если облако одно - выбираем автоматически
    if [[ "$cloud_count" -eq 1 ]]; then
        cloud_id=$(echo "$clouds" | jq -r '.clouds[0].id')
        success "Выбрано облако: $cloud_id"
    else
        echo
        echo "┌────────────────────────────────────────────────────────────┐"
        echo "│                    ДОСТУПНЫЕ ОБЛАКА                         │"
        echo "└────────────────────────────────────────────────────────────┘"
        echo
        
        local i=1
        declare -A cloud_map
        while IFS= read -r cloud; do
            local name=$(echo "$cloud" | jq -r '.name')
            local id=$(echo "$cloud" | jq -r '.id')
            
            cloud_map[$i]="$id"
            
            echo -e "${BOLD}$i)${NC} ${CYAN}$name${NC}"
            echo "   ID: $id"
            echo
            
            ((i++))
        done < <(echo "$clouds" | jq -c '.clouds[]')
        
        read -r -p "Выбери номер облака: " cloud_choice
        
        if [[ ! "$cloud_choice" =~ ^[0-9]+$ ]] || [[ -z "${cloud_map[$cloud_choice]:-}" ]]; then
            error "Неверный выбор"
            pause
            return
        fi
        
        cloud_id="${cloud_map[$cloud_choice]}"
    fi
    
    # Получаем папки
    echo
    info "📁 Получаю список папок..."
    
    folders=$(yc_api GET "https://resource-manager.api.cloud.yandex.net/resource-manager/v1/folders?cloudId=$cloud_id")
    folder_count=$(echo "$folders" | jq '.folders // [] | length')
    
    if [[ "$folder_count" -eq 0 ]]; then
        error "Папки не найдены"
        pause
        return
    fi
    
    success "Найдено папок: $folder_count"
    
    # Показываем папки
    echo
    echo "┌────────────────────────────────────────────────────────────┐"
    echo "│                    ДОСТУПНЫЕ ПАПКИ                          │"
    echo "└────────────────────────────────────────────────────────────┘"
    echo
    
    local i=1
    declare -A folder_map
    while IFS= read -r folder; do
        local name=$(echo "$folder" | jq -r '.name')
        local id=$(echo "$folder" | jq -r '.id')
        
        folder_map[$i]="$id"
        
        echo -e "${BOLD}$i)${NC} ${CYAN}$name${NC}"
        echo "   ID: $id"
        echo
        
        ((i++))
    done < <(echo "$folders" | jq -c '.folders[]')
    
    read -r -p "Выбери номер папки: " folder_choice
    
    if [[ ! "$folder_choice" =~ ^[0-9]+$ ]] || [[ -z "${folder_map[$folder_choice]:-}" ]]; then
        error "Неверный выбор"
        pause
        return
    fi
    
    folder_id="${folder_map[$folder_choice]}"
    success "Выбрана папка: $folder_id"
    
    # Получаем VM
    echo
    info "🖥️  Получаю список VM..."
    
    vms=$(yc_api GET "https://compute.api.cloud.yandex.net/compute/v1/instances?folderId=$folder_id")
    vm_count=$(echo "$vms" | jq '.instances // [] | length')
    
    if [[ "$vm_count" -eq 0 ]]; then
        warn "VM не найдены в этой папке"
        pause
        return
    fi
    
    success "Найдено VM: $vm_count"
    
    # Показываем VM
    echo
    echo "┌────────────────────────────────────────────────────────────┐"
    echo "│                 ДОСТУПНЫЕ ВИРТУАЛЬНЫЕ МАШИНЫ                │"
    echo "└────────────────────────────────────────────────────────────┘"
    echo
    
    local i=1
    declare -A vm_map
    while IFS= read -r vm; do
        local name=$(echo "$vm" | jq -r '.name')
        local id=$(echo "$vm" | jq -r '.id')
        local status=$(echo "$vm" | jq -r '.status')
        local ip=$(echo "$vm" | jq -r '.networkInterfaces[0].primaryV4Address.oneToOneNat.address // "нет IP"')
        
        vm_map[$i]="$id|$ip|$name"
        
        echo -e "${BOLD}$i)${NC} ${CYAN}$name${NC}"
        echo "   ID:     $id"
        echo "   IP:     $ip"
        echo "   Статус: $status"
        echo
        
        ((i++))
    done < <(echo "$vms" | jq -c '.instances[]')
    
    read -r -p "Выбери номер VM для мониторинга: " vm_choice
    
    if [[ ! "$vm_choice" =~ ^[0-9]+$ ]] || [[ -z "${vm_map[$vm_choice]:-}" ]]; then
        error "Неверный выбор"
        pause
        return
    fi
    
    IFS='|' read -r instance_id vm_host vm_name <<< "${vm_map[$vm_choice]}"
    
    # Проверяем что все переменные получены
    if [[ -z "$instance_id" ]] || [[ -z "$vm_host" ]] || [[ -z "$vm_name" ]]; then
        error "Ошибка получения данных VM"
        echo "Instance ID: '$instance_id'"
        echo "VM Host: '$vm_host'"
        echo "VM Name: '$vm_name'"
        pause
        return
    fi
    
    success "Выбрана VM:"
    echo "   Имя:         $vm_name"
    echo "   Instance ID: $instance_id"
    echo "   VM Host:     $vm_host"
    echo "   Folder ID:   $folder_id"
    echo
    
    # Создаём профиль
    info "💾 Создаю профиль..."
    
    # Создаём директорию если нет
    if [[ ! -d "$PROFILES_DIR" ]]; then
        mkdir -p "$PROFILES_DIR"
        echo "Создана директория: $PROFILES_DIR"
    fi
    
    # Генерируем уникальный ID
    profile_id=$(head /dev/urandom | tr -dc a-z0-9 | head -c 8)
    profile_file="$PROFILES_DIR/${profile_id}.json"
    
    echo "Файл профиля: $profile_file"
    
    # Создаём временный файл
    temp_file=$(mktemp)
    
    # Записываем JSON
    cat > "$temp_file" <<PROFILE_JSON
{
  "id": "${profile_id}",
  "name": "${vm_name}",
  "vm_host": "${vm_host}",
  "instance_id": "${instance_id}",
  "folder_id": "${folder_id}",
  "enabled": true,
  "check_interval": 60,
  "ping_count": 3,
  "ping_timeout": 5,
  "cooldown_minutes": 5,
  "max_start_attempts": 3,
  "created_at": "$(date -Iseconds)",
  "updated_at": "$(date -Iseconds)"
}
PROFILE_JSON
    
    # Проверяем что файл создан
    if [[ ! -f "$temp_file" ]]; then
        error "Не удалось создать временный файл"
        pause
        return
    fi
    
    # Проверяем JSON
    if ! jq empty "$temp_file" 2>/dev/null; then
        error "Невалидный JSON"
        cat "$temp_file"
        rm -f "$temp_file"
        pause
        return
    fi
    
    # Копируем в финальное место
    cp "$temp_file" "$profile_file"
    rm -f "$temp_file"
    
    # Проверяем что профиль создан
    if [[ ! -f "$profile_file" ]]; then
        error "Не удалось создать профиль: $profile_file"
        pause
        return
    fi
    
    success "Профиль создан: $profile_file"
    
    # Показываем содержимое
    echo
    info "Содержимое профиля:"
    cat "$profile_file" | jq .
    echo
    
    # Перезапускаем сервис в фоне
    info "🔄 Перезапускаю сервис..."
    systemctl restart "$SERVICE" &>/dev/null &
    
    success "Готово! Профиль добавлен!"
    info "Проверь логи: sudo docker logs -f vps-watchdog"
    echo
    info "Проверь логи: sudo docker logs -f vps-watchdog"
    
    pause
}



# ═══════════════════════════════════════════════════════════════════
# РЕДАКТИРОВАНИЕ/УДАЛЕНИЕ ПРОФИЛЕЙ
# ═══════════════════════════════════════════════════════════════════

edit_profile() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                   ✏️  РЕДАКТИРОВАТЬ ПРОФИЛЬ                    "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -d "$PROFILES_DIR" ]] || [[ -z "$(ls -A "$PROFILES_DIR"/*.json 2>/dev/null)" ]]; then
        warn "Нет профилей"
        pause
        return
    fi
    
    # Показываем список
    local i=1
    declare -A profile_files
    for file in "$PROFILES_DIR"/*.json; do
        [[ -f "$file" ]] || continue
        local name=$(jq -r '.name' "$file")
        profile_files[$i]="$file"
        echo -e "${BOLD}$i)${NC} $name"
        ((i++))
    done
    
    echo "0) Назад"
    echo
    read -r -p "Выбери профиль: " choice
    
    if [[ "$choice" == "0" ]]; then
        return
    fi
    
    if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ -z "${profile_files[$choice]:-}" ]]; then
        error "Неверный выбор"
        pause
        return
    fi
    
    local file="${profile_files[$choice]}"
    
    # Редактируем
    echo
    info "Редактирование: $(jq -r '.name' "$file")"
    echo
    
    read -r -p "Новое имя [Enter - оставить]: " new_name
    read -r -p "Интервал проверки в секундах [Enter - оставить]: " new_interval
    read -r -p "Cooldown в минутах [Enter - оставить]: " new_cooldown
    
    # Обновляем
    local tmp_file=$(mktemp)
    jq "$(
        echo '.'
        [[ -n "$new_name" ]] && echo "| .name = \"$new_name\""
        [[ -n "$new_interval" ]] && echo "| .check_interval = $new_interval"
        [[ -n "$new_cooldown" ]] && echo "| .cooldown_minutes = $new_cooldown"
        echo "| .updated_at = \"$(date -Iseconds)\""
    )" "$file" > "$tmp_file"
    
    mv "$tmp_file" "$file"
    
    success "Профиль обновлён!"
    systemctl restart "$SERVICE"
    pause
}

delete_profile() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                     🗑️  УДАЛИТЬ ПРОФИЛЬ                       "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -d "$PROFILES_DIR" ]] || [[ -z "$(ls -A "$PROFILES_DIR"/*.json 2>/dev/null)" ]]; then
        warn "Нет профилей"
        pause
        return
    fi
    
    # Показываем список
    local i=1
    declare -A profile_files
    for file in "$PROFILES_DIR"/*.json; do
        [[ -f "$file" ]] || continue
        local name=$(jq -r '.name' "$file")
        profile_files[$i]="$file"
        echo -e "${BOLD}$i)${NC} $name"
        ((i++))
    done
    
    echo "0) Назад"
    echo
    read -r -p "Выбери профиль для удаления: " choice
    
    if [[ "$choice" == "0" ]]; then
        return
    fi
    
    if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ -z "${profile_files[$choice]:-}" ]]; then
        error "Неверный выбор"
        pause
        return
    fi
    
    local file="${profile_files[$choice]}"
    local name=$(jq -r '.name' "$file")
    
    echo
    warn "Удалить профиль '$name'?"
    read -r -p "(yes/no): " confirm
    
    if [[ "$confirm" == "yes" ]]; then
        rm "$file"
        success "Профиль удалён!"
        systemctl restart "$SERVICE"
    else
        info "Отменено"
    fi
    
    pause
}

toggle_profile() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "              🔄 ВКЛЮЧИТЬ/ВЫКЛЮЧИТЬ МОНИТОРИНГ                 "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -d "$PROFILES_DIR" ]] || [[ -z "$(ls -A "$PROFILES_DIR"/*.json 2>/dev/null)" ]]; then
        warn "Нет профилей"
        pause
        return
    fi
    
    # Показываем список
    local i=1
    declare -A profile_files
    for file in "$PROFILES_DIR"/*.json; do
        [[ -f "$file" ]] || continue
        local name=$(jq -r '.name' "$file")
        local enabled=$(jq -r '.enabled' "$file")
        local status="🔴 выключен"
        [[ "$enabled" == "true" ]] && status="🟢 включен"
        profile_files[$i]="$file"
        echo -e "${BOLD}$i)${NC} $name ($status)"
        ((i++))
    done
    
    echo "0) Назад"
    echo
    read -r -p "Выбери профиль: " choice
    
    if [[ "$choice" == "0" ]]; then
        return
    fi
    
    if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ -z "${profile_files[$choice]:-}" ]]; then
        error "Неверный выбор"
        pause
        return
    fi
    
    local file="${profile_files[$choice]}"
    local current=$(jq -r '.enabled' "$file")
    local new_state="false"
    [[ "$current" == "false" ]] && new_state="true"
    
    jq ".enabled = $new_state | .updated_at = \"$(date -Iseconds)\"" "$file" > "$file.tmp"
    mv "$file.tmp" "$file"
    
    if [[ "$new_state" == "true" ]]; then
        success "Мониторинг включен!"
    else
        success "Мониторинг выключен!"
    fi
    
    systemctl restart "$SERVICE"
    pause
}

# ═══════════════════════════════════════════════════════════════════
# TELEGRAM
# ═══════════════════════════════════════════════════════════════════

setup_telegram() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                   🤖 НАСТРОЙКА TELEGRAM БОТА                   "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    info "📋 ИНСТРУКЦИЯ:"
    echo
    echo "1️⃣  Создай бота через @BotFather в Telegram"
    echo "   • Отправь команду: /newbot"
    echo "   • Придумай имя бота"
    echo "   • Скопируй токен (выглядит так: 123456:ABC-DEF...)"
    echo
    echo "2️⃣  Получи Chat ID"
    echo "   • Напиши своему боту любое сообщение"
    echo "   • Открой: https://api.telegram.org/botТВОЙ_ТОКЕН/getUpdates"
    echo "   • Найди \"chat\":{\"id\":123456789"
    echo
    hr
    echo
    
    read -r -p "Bot Token: " bot_token
    
    if [[ -z "$bot_token" ]]; then
        error "Токен пустой"
        pause
        return
    fi
    
    read -r -p "Chat ID: " chat_id
    
    if [[ -z "$chat_id" ]]; then
        error "Chat ID пустой"
        pause
        return
    fi
    
    # Тестируем подключение
    info "🔄 Проверяю подключение..."
    
    response=$(curl -s "https://api.telegram.org/bot${bot_token}/getMe")
    
    if echo "$response" | jq -e '.ok == true' >/dev/null 2>&1; then
        bot_username=$(echo "$response" | jq -r '.result.username')
        success "Бот подключен: @$bot_username"
        
        # Сохраняем конфиг
        mkdir -p "$CONFIG_DIR"
        cat > "$TELEGRAM_CONFIG" <<EOF
{
  "bot_token": "$bot_token",
  "chat_id": "$chat_id",
  "enabled": true,
  "notify_on_down": true,
  "notify_on_up": true,
  "notify_on_error": true,
  "notify_on_start": false
}
EOF
        
        success "Конфигурация сохранена!"
        
        # Отправляем тестовое сообщение
        curl -s -X POST "https://api.telegram.org/bot${bot_token}/sendMessage" \
            -d "chat_id=${chat_id}" \
            -d "text=🛡️ <b>VPS Watchdog подключен!</b>%0A%0AУведомления активированы." \
            -d "parse_mode=HTML" >/dev/null
        
        success "Тестовое сообщение отправлено!"
        
        # Перезапускаем сервис
        systemctl restart "$SERVICE"
        
    else
        error "Не удалось подключиться к боту"
        echo "Проверь Bot Token"
    fi
    
    pause
}

test_telegram() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                   📤 ТЕСТ УВЕДОМЛЕНИЯ                         "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -f "$TELEGRAM_CONFIG" ]]; then
        error "Telegram не настроен"
        info "Настрой бота через пункт 6"
        pause
        return
    fi
    
    bot_token=$(jq -r '.bot_token' "$TELEGRAM_CONFIG")
    chat_id=$(jq -r '.chat_id' "$TELEGRAM_CONFIG")
    
    info "Отправляю тестовое уведомление..."
    
    message="🧪 <b>Тестовое уведомление</b>%0A%0A⏰ Время: $(date '+%d.%m.%Y %H:%M:%S')%0A✅ Telegram работает!"
    
    response=$(curl -s -X POST "https://api.telegram.org/bot${bot_token}/sendMessage" \
        -d "chat_id=${chat_id}" \
        -d "text=${message}" \
        -d "parse_mode=HTML")
    
    if echo "$response" | jq -e '.ok == true' >/dev/null 2>&1; then
        success "Сообщение отправлено!"
    else
        error "Ошибка отправки"
        echo "$response" | jq .
    fi
    
    pause
}

telegram_status() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                     📊 СТАТУС TELEGRAM                        "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    if [[ ! -f "$TELEGRAM_CONFIG" ]]; then
        error "Telegram не настроен"
        pause
        return
    fi
    
    bot_token=$(jq -r '.bot_token' "$TELEGRAM_CONFIG")
    chat_id=$(jq -r '.chat_id' "$TELEGRAM_CONFIG")
    enabled=$(jq -r '.enabled' "$TELEGRAM_CONFIG")
    
    response=$(curl -s "https://api.telegram.org/bot${bot_token}/getMe")
    
    if echo "$response" | jq -e '.ok == true' >/dev/null 2>&1; then
        bot_username=$(echo "$response" | jq -r '.result.username')
        bot_name=$(echo "$response" | jq -r '.result.first_name')
        
        echo -e "${GREEN}✅ Бот подключен${NC}"
        echo
        echo "   Имя:      $bot_name"
        echo "   Username: @$bot_username"
        echo "   Chat ID:  $chat_id"
        echo -e "   Статус:   $([ "$enabled" == "true" ] && echo "${GREEN}включен${NC}" || echo "${RED}выключен${NC}")"
        echo
        
        info "Настройки уведомлений:"
        echo "   🔴 VM упала:       $(jq -r '.notify_on_down' "$TELEGRAM_CONFIG")"
        echo "   🟢 VM запущена:    $(jq -r '.notify_on_up' "$TELEGRAM_CONFIG")"
        echo "   ⚠️  Ошибки:         $(jq -r '.notify_on_error' "$TELEGRAM_CONFIG")"
        
    else
        error "Бот недоступен"
    fi
    
    pause
}

# ═══════════════════════════════════════════════════════════════════
# УПРАВЛЕНИЕ OAUTH
# ═══════════════════════════════════════════════════════════════════

manage_oauth() {
    clear
    title "═══════════════════════════════════════════════════════════════"
    title "                🔑 УПРАВЛЕНИЕ OAUTH ТОКЕНОМ                    "
    title "═══════════════════════════════════════════════════════════════"
    echo
    
    oauth_file="$CONFIG_DIR/oauth-token.txt"
    
    # Проверяем наличие токена
    if [[ -f "$oauth_file" ]]; then
        oauth_token=$(cat "$oauth_file" 2>/dev/null)
        token_preview="${oauth_token:0:20}...${oauth_token: -10}"
        
        success "OAuth токен найден"
        echo "   Файл: $oauth_file"
        echo "   Токен: $token_preview"
        echo
        
        # Проверяем валидность токена
        info "🔄 Проверяю валидность токена..."
        
        iam_response=$(curl -s -X POST \
            -H "Content-Type: application/json" \
            -d "{\"yandexPassportOauthToken\": \"$oauth_token\"}" \
            "https://iam.api.cloud.yandex.net/iam/v1/tokens")
        
        if echo "$iam_response" | jq -e '.iamToken' >/dev/null 2>&1; then
            success "✅ Токен валиден"
        else
            error "❌ Токен невалиден или истёк"
            echo
            warn "Возможные причины:"
            echo "   • Токен устарел (срок действия OAuth токенов ограничен)"
            echo "   • Токен был отозван в настройках аккаунта"
            echo "   • Проблемы с интернет-соединением"
        fi
        
        echo
        hr
        echo
        echo "  1) 🔄 Обновить токен"
        echo "  2) 🗑️  Удалить токен"
        echo "  3) 👁️  Показать полный токен"
        echo "  0) ← Назад"
        echo
        
        read -r -p "Выбери: " choice
        
        case $choice in
            1)
                info "🌐 Получение нового OAuth токена"
                echo
                echo "Открой эту ссылку в браузере:"
                echo
                echo -e "${GREEN}${BOLD}https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb${NC}"
                echo
                read -r -p "Вставь новый OAuth токен: " new_token
                
                if [[ -n "$new_token" ]]; then
                    echo "$new_token" > "$oauth_file"
                    chmod 600 "$oauth_file"
                    success "Токен обновлён!"
                    
                    # Перезапускаем сервис
                    info "🔄 Перезапускаю сервис..."
                    systemctl restart "$SERVICE" &>/dev/null &
                    success "Сервис перезапускается"
                else
                    error "Токен пустой"
                fi
                pause
                ;;
            2)
                warn "Удалить OAuth токен?"
                echo "   ⚠️  После удаления потребуется новая авторизация"
                echo
                read -r -p "(yes/no): " confirm
                
                if [[ "$confirm" == "yes" ]]; then
                    rm -f "$oauth_file"
                    success "Токен удалён"
                else
                    info "Отменено"
                fi
                pause
                ;;
            3)
                echo
                info "Полный OAuth токен:"
                echo
                echo -e "${CYAN}$oauth_token${NC}"
                echo
                warn "⚠️  Не делись этим токеном!"
                pause
                ;;
            0)
                return
                ;;
            *)
                warn "Неверный выбор"
                pause
                ;;
        esac
    else
        warn "OAuth токен не найден"
        echo
        info "Токен будет создан автоматически при добавлении первого профиля"
        echo "   через пункт меню: 2) ➕ Добавить профиль (OAuth)"
        echo
        hr
        echo
        echo "  1) 🔑 Добавить OAuth токен вручную"
        echo "  0) ← Назад"
        echo
        
        read -r -p "Выбери: " choice
        
        case $choice in
            1)
                info "🌐 Получение OAuth токена"
                echo
                echo "Открой эту ссылку в браузере:"
                echo
                echo -e "${GREEN}${BOLD}https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb${NC}"
                echo
                read -r -p "Вставь OAuth токен: " new_token
                
                if [[ -n "$new_token" ]]; then
                    mkdir -p "$CONFIG_DIR"
                    echo "$new_token" > "$oauth_file"
                    chmod 600 "$oauth_file"
                    success "Токен сохранён!"
                else
                    error "Токен пустой"
                fi
                pause
                ;;
            0)
                return
                ;;
            *)
                warn "Неверный выбор"
                pause
                ;;
        esac
    fi
}

# ═══════════════════════════════════════════════════════════════════
# УПРАВЛЕНИЕ СЕРВИСОМ
# ═══════════════════════════════════════════════════════════════════

service_menu() {
    while true; do
        clear
        title "═══════════════════════════════════════════════════════════════"
        title "                   🔧 УПРАВЛЕНИЕ СЕРВИСОМ                      "
        title "═══════════════════════════════════════════════════════════════"
        echo
        
        echo "  1) ▶️  Запустить"
        echo "  2) ⏹️  Остановить"
        echo "  3) 🔄 Перезапустить"
        echo "  4) 📊 Статус"
        echo "  0) ← Назад"
        echo
        
        read -r -p "Выбери: " choice
        
        case $choice in
            1) systemctl start "$SERVICE"; success "Сервис запущен"; pause ;;
            2) systemctl stop "$SERVICE"; success "Сервис остановлен"; pause ;;
            3) systemctl restart "$SERVICE"; success "Сервис перезапущен"; pause ;;
            4) systemctl status "$SERVICE"; pause ;;
            0) return ;;
            *) warn "Неверный выбор"; pause ;;
        esac
    done
}

