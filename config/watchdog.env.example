# ═══════════════════════════════════════════════════════════════════
# VPS Watchdog - Конфигурация
# ═══════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────┐
# │ 1. ОСНОВНЫЕ НАСТРОЙКИ                                           │
# └─────────────────────────────────────────────────────────────────┘

# IP адрес вашей VM (который пингуем)
VM_HOST=

# ID виртуальной машины в Yandex Cloud
# Получить: yc compute instance list
INSTANCE_ID=

# Путь к ключу Service Account (не трогай, если не знаешь зачем)
SA_KEY_FILE=/app/config/sa-key.json

# ┌─────────────────────────────────────────────────────────────────┐
# │ 2. НАСТРОЙКИ МОНИТОРИНГА                                        │
# └─────────────────────────────────────────────────────────────────┘

# Как часто проверять VM (секунды)
CHECK_INTERVAL=60

# Сколько раз пинговать
PING_COUNT=3

# Таймаут ping (секунды)
PING_TIMEOUT=5

# ┌─────────────────────────────────────────────────────────────────┐
# │ 3. ЗАЩИТА ОТ ЧАСТЫХ ПЕРЕЗАПУСКОВ                               │
# └─────────────────────────────────────────────────────────────────┘

# Сколько минут ждать между попытками запуска
COOLDOWN_MINUTES=5

# Максимум попыток запуска подряд (потом ждём дольше)
MAX_START_ATTEMPTS=3
